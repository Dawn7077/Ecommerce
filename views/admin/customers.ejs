<%- include("../../views/partials/admin/header") %>
<div class="content-header row">
    <div class="d-flex justify-content-between align-items-center">
        <h2 class="content-title card-title">Customers</h2>
       
    </div>
</div>         
        </div>
        
            <header class="card-header text-center mb-20">
                <form action="/admin/users/" method="get" class="d-inline">
                    <div class="input-group input-group-sm border border-1 border-grey rounded-pill d-flex align-items-center" style="width: 500px; margin-left: 310px;">
                        <input type="text" class="form-control border-0 rounded-pill" placeholder="Search customers..." name="search" value="<%= search?search:'' %>">

                        <% if(search !=='') {%>
                            <a href="/admin/users" class="btn btn-secondary rounded-pill d-flex align-items-center ">X</a>
                        <% } %>
                        <button class="btn  border-0" type="submit">Search</button>
                    </div>
                </form>
            </header>
            <div class="right mt-5">
                <table class="table table-striped">
                    <thead>
                      <tr>
                        <th scope="col"><b>Name</b></th>
                        <th scope="col"><b>Email</b></th>
                        <th scope="col"><b>Phone No</b></th>
                        <th scope="col"><b>Action</b></th>
                        <!-- <th scope="col"><b>Action</b></th> -->
                      </tr>
                    </thead>
                    <tbody>
                        <% for(let i=0;i<data.length;i++){ %>
                            <tr>
                                <td><%=data[i].name %></td>
                                <td><%=data[i].email %></td>
                                <td><%=data[i].phone %></td>
                                <td> 
                                    <% if(data[i].isBlocked === false){ %>
                                        <button class="btn btn-danger" style="width: 80px;">
                                            <a href="/admin/blockCustomer?id=<%= data[i]._id  %>"class="text-white" style="text-decoration: none;" onclick="return confirmBlock()">Block</a>
                                        </button>
                                        <% }else{ %>
                                        <button class="btn btn-success" style="width: 80px;">
                                            <a href="/admin/unBlockCustomer?id=<%= data[i]._id %>" class="text-white" style="text-decoration: none;" onclick="return confirmUnblock()">Unblock</a>
                                        </button> 
                                        <% } %>
                                </td>
                                <!-- <td>
                                    <button
                                    class="btn btn-danger"
                                    style="width: 90px"
                                    onclick="return confirmDelete()"
                                    >
                                    <a href="/admin/deleteCustomer?id=<%=data[i]._id %>" class="text-white">Delete</a>
                                    </button>
                                </td> -->
                            </tr>
                            <% } %>
                    </tbody>
                  </table>
        </div>
        <div class="container mt-3">
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center mb-20" >
                    <% for(let i=1;i<=totalPages;i++){ %>
                        <li class="page-item <%=(i===currentPage)?'active':'' %>">
                            <a class="page-link" href="?page=<%=i %><% if (search) { %>&search=<%= search %><% } %>"> <%= i %></a>
                        </li>
                        <% } %>
                </ul>
            </nav>
        </div>
        <% if(deleted){ %>
            <script>
                alert("customer deleted successfully");
                </script>
            <% } %>
        <script>
            function confirmDelete(){
                return confirm("Are you sure you want to delete this User? ")
            }
            function confirmBlock(){
                return confirm("Are you sure you want to Block this User? ")
            }
            function confirmUnblock(){
                return confirm("Are you sure you want to Unblock this User? ")
            }
        </script>
        <%- include("../../views/partials/admin/footer") %>
