<%- include("../../views/partials/admin/header") %>
    <div class="content-header row">
        <div class="d-flex justify-content-between align-items-center">
            <h2 class="content-title card-title">Customers</h2>
        </div>
    </div>

    <header class="card-header text-center mb-20">
        <form id="searchForm" class="d-inline">
            <div class="input-group input-group-sm border border-1 border-grey rounded-pill d-flex align-items-center"
                style="width: 500px; margin-left: 310px;">
                <input type="text" id="searchInput" class="form-control border-0 rounded-pill"
                    placeholder="Search customers..." name="search" value="<%= search ? search : '' %>">
                <button type="button" id="clearSearch" class="btn btn-secondary rounded-pill d-flex align-items-center"
                    style="<%= search === '' ? 'display: none !important;' : '' %>">
                    X
                </button>
                <button class="btn border-0" type="submit">Search</button>
            </div>
        </form>
    </header>

    <div class="right mt-5">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th scope="col"><b>Name</b></th>
                    <th scope="col"><b>Email</b></th>
                    <th scope="col"><b>Phone No</b></th>
                    <th scope="col"><b>Action</b></th>
                </tr>
            </thead>
            <tbody id="customerTableBody">
                <% for(let i=0; i<data.length; i++){ %>
                    <tr data-user-id="<%= data[i]._id %>">
                        <td>
                            <%= data[i].name %>
                        </td>
                        <td>
                            <%= data[i].email %>
                        </td>
                        <td>
                            <%= data[i].phone %>
                        </td>
                        <td>
                            <button class="btn <%= data[i].isBlocked ? 'btn-success' : 'btn-danger' %> block-btn"
                                style="width: 80px;" data-id="<%= data[i]._id %>"
                                data-blocked="<%= data[i].isBlocked %>">
                                <%= data[i].isBlocked ? 'Unblock' : 'Block' %>
                            </button>
                        </td>
                    </tr>
                    <% } %>
            </tbody>
        </table>
    </div>

    <div class="container mt-3">
        <nav aria-label="Page navigation">
            <ul class="pagination justify-content-center mb-20" id="pagination">
                <% for(let i=1; i<=totalPages; i++){ %>
                    <li class="page-item <%= (i === currentPage) ? 'active' : '' %>">
                        <a class="page-link page-link-btn" href="#" data-page="<%= i %>">
                            <%= i %>
                        </a>
                    </li>
                    <% } %>
            </ul>
        </nav>
    </div>

    <script>
        window.params = {
            currentPage: <%= currentPage %>,
            currentSearch: '<%= search %>'
    };
    </script>
    <script src="/admin/js/customer.js"></script>

    <%- include("../../views/partials/admin/footer") %>