<%- include("../../views/partials/admin/header") %>

<link rel="stylesheet" href="/admin/style/offerManagement.css">

<section class="content-main">
    <div class="content-header">
        <div>
            <h2 class="content-title">Offer Management</h2>
            <p>Manage all product and category offers </p>
        </div>
    </div>

    <!-- Filter Tabs -->
    <div class="filter-tabs">
        <a href="/admin/offer-management?filterType=all"  style="text-decoration: none;"
           class="filter-tab <%= filterType === 'all' ? 'active' : '' %>">
            <i class="fas fa-list"></i> All Offers
        </a>
        <a href="/admin/offer-management?filterType=product" style="text-decoration: none;"
           class="filter-tab <%= filterType === 'product' ? 'active' : '' %>">
            <i class="fas fa-box"></i> Product Offers
        </a>
        <a href="/admin/offer-management?filterType=category" style="text-decoration: none;"
           class="filter-tab <%= filterType === 'category' ? 'active' : '' %>">
            <i class="fas fa-tags"></i> Category Offers
        </a>
    </div>

    <!-- Search Bar -->
    <div class="card mb-4">
        <div class="card-body">
            <form action="/admin/offer-management" method="GET" class="row g-3">
                <input type="hidden" name="filterType" value="<%= filterType %>">
                <div class="col-md-10">
                    <input 
                        type="text" 
                        class="form-control" 
                        name="search" 
                        placeholder="Search offers..." 
                        value="<%= search %>">
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fas fa-search"></i> Search
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Category Offers  -->
    <% if (filterType === 'all' || filterType === 'category') { %>
    <div class="card mb-4">
        <div class="card-header">
            <h4 class="mb-0">
                <i class="fas fa-tags"></i> Category Offers
                <span class="badge bg-primary ms-2 py-1"><%= categories.length %></span>
            </h4>
        </div>
        <div class="card-body">
            <% if (categories.length > 0) { %>
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Category Name</th>
                            <th>Description</th>
                            <th>Offer Percentage</th>
                            <th>Status</th>
                            <th >Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% categories.forEach(category => { %>
                        <tr>
                            <td><strong><%= category.name %></strong></td>
                            <td><%= category.description.substring(0, 50) %>...</td>
                            <td>
                                <span class="offer-badge"><%= category.categoryOffer %>% OFF</span>
                            </td>
                            <td>
                                <% if (category.isListed) { %>
                                    <span class="badge bg-success">Active</span>
                                <% } else { %>
                                    <span class="badge bg-secondary">Inactive</span>
                                <% } %>
                            </td>
                            <td class="">
                                <div class="action-btn-group">
                                    <button 
                                        class="btn btn-warning btn-sm" 
                                        onclick="editCategoryOffer('<%= category._id %>', '<%= category.categoryOffer %>')">
                                        <i class="fas fa-edit"></i> Edit
                                    </button>
                                    <button 
                                        class="btn btn-danger btn-sm" 
                                        onclick="removeCategoryOffer('<%= category._id %>')">
                                        <i class="fas fa-trash"></i> Remove
                                    </button>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <% } else { %>
                <div class="text-center py-5">
                    <i class="fas fa-tags fa-3x text-muted mb-3"></i>
                    <p class="text-muted">No category offers found</p>
                    <a href="/admin/category" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Add Category Offer
                    </a>
                </div>
            <% } %>
        </div>
    </div>
    <% } %>

    <!-- Product Offers Section -->
    <% if (filterType === 'all' || filterType === 'product') { %>
    <div class="card mb-4">
        <div class="card-header">
            <h4 class="mb-0">
                <i class="fas fa-box"></i> Product Offers
                <span class="badge bg-primary ms-2"><%= products.length %></span>
            </h4>
        </div>
        <div class="card-body">
            <% if (products.length > 0) { %>
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th>Category</th>
                            <th>Regular Price</th>
                            <th>Offer</th>
                            <th>Sale Price</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% products.forEach(product => { %>
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <img 
                                        src="/uploads/product-image/<%= product.productImage[0] %>" 
                                        class="product-img me-2">
                                    <strong><%= product.productName %></strong>
                                </div>
                            </td>
                            <td><%= product.category[0].name %></td>
                            <td>₹<%= product.regularPrice %></td>
                            <td>
                                <span class="offer-badge"><%= product.productOffer %>% OFF</span>
                            </td>
                            <td>
                                <strong class="text-success">₹<%= product.salesPrice %></strong>
                            </td>
                            <td>
                                <% if (!product.isBlocked && product.status === 'Available') { %>
                                    <span class="badge bg-success">Active</span>
                                <% } else { %>
                                    <span class="badge bg-secondary">Inactive</span>
                                <% } %>
                            </td>
                            <td class="">
                                <div class="action-btn-group">
                                    <button 
                                        class="btn btn-warning btn-sm" 
                                        onclick="editProductOffer('<%= product._id %>',' <%= product.productOffer %>')">
                                        <i class="fas fa-edit"></i> Edit
                                    </button>
                                    <button 
                                        class="btn btn-danger btn-sm" 
                                        onclick="removeProductOffer('<%= product._id %>')">
                                        <i class="fas fa-trash"></i> Remove
                                    </button>
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            <% } else { %>
                <div class="text-center py-5">
                    <i class="fas fa-box-open fa-3x text-muted mb-3"></i>
                    <p class="text-muted">No product offers found</p>
                    <a href="/admin/addProducts" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Add Product Offer
                    </a>
                </div>
            <% } %>
        </div>
    </div>
    <% } %>

    <!-- Pagination -->
    <% if (totalPages > 1) { %>
    <div class="pagination-area mt-3 mb-5">
        <nav>
            <ul class="pagination justify-content-center">
                <% for(let i = 1; i <= totalPages; i++) { %>
                    <li class="page-item <%= i === currentPage ? 'active' : '' %>">
                        <a class="page-link" href="?page=<%= i %>&filterType=<%= filterType %>&search=<%= search %>">
                            <%= i %>
                        </a>
                    </li>
                <% } %>
            </ul>
        </nav>
    </div>
    <% } %>

</section>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script src="/admin/js/offerManagement.js"></script>

<%- include("../../views/partials/admin/footer") %>