<%- include("../../views/partials/admin/header") %>
<head>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@10/dist/sweetalert2.min.css">
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet"> 
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<style>
.pagination-container {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 8px;
}

.pagination-container a,
.pagination-container span {
  padding: 6px 12px;
  border: 1px solid #ddd;
  border-radius: 5px;
  text-decoration: none;
  color: #007bff;
}
  

  .pagination a:hover {
    background-color: #e1e1e1;
  }
  .error-message {
    color: red;
  }
</style>
<section class="content-main">
  <div class="content-header">
    <div>
      <h2 class="content-title card-title">Brands</h2>
    </div>
  </div>
  <header class="card-header text-center mb-20">
      <form action="/admin/brands/" method="get" class="d-inline">
        <div class="input-group input-group-sm border border-1 border-grey rounded-pill  d-flex align-items-center" style="width: 500px; margin-left: 310px;  " >
          <input type="text" value="<%= search?search:'' %>" class="form-control border-0 rounded-pill " placeholder="Search brand" name="search" />

          <% if(search !=='') {%>
          <a href="/admin/brands" class="btn btn-secondary rounded-pill d-flex align-items-center ">X</a>
            <% } %>
          <button class="btn" type="submit">Search</button>
        </div>
      </form>
    </header>
  <div class="card">
    <div class="card-body">
      <div class="row">
        <div class="col-md-3">
          <div id="addForm">
            <form id="addBrandForm" enctype="multipart/form-data">
              <div class="mb-4">
                <label for="product_name" class="form-label">Brand Name</label>
                <input
                  type="text"
                  name="name"
                  placeholder="Type here"
                  class="form-control"
                />
              </div>
              <label for="product_name" class="form-label">Brand Image</label>
              <div class="input-upload">
                <img src="" alt=""/>
                <input class="form-control border" name="image" type="file" />
              </div>
              <div class="d-grid">
                <button class="btn btn-primary mt-20" type="button" onclick="addBrand()">
                  Add Brand
                </button>
              </div>
            </form>
          </div>
          <!-- edit -->
          <div id="editForm" style="display: none;"> 
            <form id="editBrandForm" enctype="multipart/form-data">
              <input type="hidden" name="brandId" id="editBrandId" />
              <div class="mb-4">
                <label  class="form-label">Brand Name</label>
                <input type="text" name="name" id="editBrandName" class="form-control" />
              </div>
              <label class="form-label">Brand Image</label>
              <div class="input-upload">
                <img src="" alt="" id="editPreview" style="width:80px;margin-bottom: 10px;" />
                <input type="file" class="form-control border" name="image">
              </div>

              <div class="d-grid">
                <button class="btn btn-primary mt-20"  type="button" onclick="updateBrand()">Update Brand</button>
              </div>
            </form>
          </div>
        </div>
        <div class="col-md-7 ml-105">
          <div class="table-responsive">
            <table class="table table-hover">
              <thead>
                <tr>
                  <th>Brand</th>
                  <th>Logo</th>
                  <th>Status</th>
                  <th>Block/Unblock/Delete</th>
                </tr>
              </thead>
              <tbody>
                <% data.reverse().forEach((brand,index)=>{ %>
                <tr>
                  <td class="text-start"><%= brand.brandName %></td>
                  <td class="text-start">
                    <div
                      class="d-flex align-items-center justify-content-center"
                      style="
                        width: 40px;
                        height: 40px;
                        border-radius: 50%;
                        overflow: hidden;
                      "
                    >
                      <img
                        src="/uploads/product-image/<%= brand.brandImage %>"
                        alt="<%= brand.brandName %>"
                        class="img-fluid rounded-circle"
                        style="width: 100%; height: auto"
                      />
                    </div>
                  </td>
                  <td class="text-start">
                    <% if(brand.isBlocked === true){ %>
                    <span
                      class="badge rounded-pill btn-danger"
                      style="width: 60px"
                      >Blocked
                    </span>
                    <% }else{ %>
                    <span
                      class="badge rounded-pill btn-success"
                      style="width: 60px"
                      >Active</span
                    >
                    <% } %>
                  </td>
                  <td class="text-start">
                    <% if(brand.isBlocked === false){ %>
                    <button class="btn btn-danger" style="width: 90px">
                      <a href="/admin/blockBrand?id=<%=brand._id %>" class="text-white">Block</a>
                    </button>
                    <% }else{ %>
                    <button class="btn btn-success" style="width: 90px">
                      <a href="/admin/unBlockBrand?id=<%=brand._id %>" class="text-white">Unblock</a>
                    </button>
                    <% } %>
                    <button
                      class="btn btn-danger"
                      style="width: 90px"
                      onclick="return confirmDelete()"
                    >
                      <a href="/admin/deleteBrand?id=<%=brand._id %>" class="text-white">Delete</a>
                    </button>
                    <button
                      class="btn btn-danger"
                      style="width: 90px"
                      onclick=" Edit('<%= brand._id%>','<%= brand.brandName%>','<%= brand.brandImage%>')">Edit</a>
                    </button>
                  </td>
                </tr>


                <%})%>
                </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  </div>

  
 
  <!-- <div class="pagination-container">
        <% if(currentPage>1){ %>
            <a href="?page=<%=currentPage - 1 %>">&laquo; Previous</a>
        <% } %> <% for(let i=1; i<=totalPages; i++){ %>
                <% if(i=== currentPage){ %>
                    <span class="current-page"><%= i %></span>
                <% }else{ %>
                    <a href="?page=<%= i %>" ><%= i %></a>
                <% } %>
                <% } %>
                <% if(currentPage<totalPages){ %>
                <a href="?page=<%=currentPage +1 %>">Next &raquo;</a>
                <% } %>
    </div> -->

    <div class="pagination-container ms-3">
   <nav aria-label="Page navigation">
       <ul class="pagination justify-content-center mb-20">


           <% for (let i = 1; i <= totalPages; i++) { %>
           <li class="page-item <%=(i === currentPage) ? 'active' : '' %>">
               <a class="page-link" href="?page=<%= i %>&search=<%=search %>"><%= i %></a>
           </li>
           <% } %>


       </ul>
   </nav>
</div>
 

<% if(updated){ %>
  <script> 
    Swal.fire('Product Updated', 'Product has been updated successfully!', 'success');
    </script>
    <% } %>
    

<script>
   async function addBrand(){
    const form  = document.getElementById('addBrandForm')
    const formData = new FormData(form)
    console.log(formData)

    try {
      const res = await fetch('/admin/addBrand',{
        method:'POST',
        body:formData
      })

      const data = await res.json()
      if(data.success){
        Swal.fire({ 
        icon: 'success',
        title: 'Brand Added',
        text: 'Brand added successfully!'
        }).then(()=>{
          window.location.reload()
        })
      }else{
        Swal.fire({
        icon: 'error',
        title: 'Oops!',
        text: data.message
      });
      }
    } catch (error) {
      Swal.fire({
      icon: 'error',
      title: 'Error',
      text: 'Something went wrong'
    });
    }
  }

  async function updateBrand(){
    const form = document.getElementById('editBrandForm')
    const formData = new FormData(form)

    try {
      const res = await fetch('/admin/editBrand',{
        method:'POST',
        body:formData
      })

      const data = await res.json()

      if(data.success){
        Swal.fire({
          icon: 'success',
          title: 'Updated!',
          text: data.message
        }).then(() => window.location.reload());
      }else{
        Swal.fire({
          icon: 'error',
          title: 'Oops!',
          text: data.message
        });
      }
    } catch (error) {
      Swal.fire({
        icon: 'error',
        title: 'Error',
        text: 'Something went wrong'
      });
    }
  }

  function confirmDelete(){
    return confirm("Are you sure you want to delete this brand? ")
  }

  function Edit(id,name,image){
    document.getElementById('addForm').style.display='none'
    document.getElementById('editForm').style.display= 'block'

    document.getElementById('editBrandId').value= id
    document.getElementById('editBrandName').value= name

    document.getElementById('editPreview').src = '/uploads/product-image/'+ image
  }
  </script>
  
</section>
<%- include("../../views/partials/admin/footer") %>
 
