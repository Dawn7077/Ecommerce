<%- include("../../views/partials/admin/header") %>
<style>
  #topCategoriesChart{
    width: 500px;
  }
</style>

<section class="content-main">
  <div class="content-header d-flex justify-content-between align-items-center">
    <h2 class="content-title card-title mb-0">Dashboard</h2>
    <div class="dashboard-date text-muted">
      <%= new Date().toDateString() %>
    </div>
  </div>

  <div class="row g-4 mt-4">
    <!-- Stats Cards -->
    <div class="col-md-3">
      <div class="card dashboard-card">
        <div class="card-body text-center">
          <i class="fas fa-users dashboard-icon text-primary"></i>
          <h5>Total Users</h5>
          <h2><%= totalUsers %></h2>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card dashboard-card">
        <div class="card-body text-center">
          <i class="fas fa-boxes dashboard-icon text-success"></i>
          <h5>Products</h5>
          <h2><%= totalProducts %></h2>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card dashboard-card">
        <div class="card-body text-center">
          <i class="fas fa-shopping-cart dashboard-icon text-warning"></i>
          <h5>Orders</h5>
          <h2><%= totalOrders %></h2>
        </div>
      </div>
    </div>

    <div class="col-md-3">
      <div class="card dashboard-card">
        <div class="card-body text-center">
          <i class="fas fa-dollar-sign dashboard-icon text-danger"></i>
          <h5>Revenue</h5>
          <h6 class="text-muted">Delivered & Paid</h6>
          <h2>₹<%= totalRevenue.toFixed(2).toLocaleString('en-IN') %></h2>
          <small class="text-muted">Net Sales: ₹<%= netSales.toFixed(2).toLocaleString('en-IN') %></small>
        </div>
      </div>
    </div>

  <!-- filter -->

  <div class="d-flex gap-2 mb-3">
    <select id="filterType" class="form-select w-auto">
      <option value="daily">Today</option>
      <option value="monthly">This Month</option>
      <option value="yearly">This Year</option>
    </select>
  </div>



  <!-- Chart Section -->
  <div class="card mt-5">
    <div class="card-header d-flex justify-content-between">
      <h5 class="d-flex align-items-center">Sales Overview</h5>
      <a href="/admin/sales-report" class="btn btn-primary">Report</a>
    </div>
    <div class="card-body">

      <canvas id="salesChart" height="120"></canvas> 
      <canvas id="topProductsChart"></canvas>
      <div class="row d-flex justify-content-between  mt-5">
        <div class="col-md-6 col-lg-6">
          <h5>Top Categories</h5>
          <canvas id="topCategoriesChart"></canvas>
        </div>

        <div class="col-md-6 col-lg-6 mx-auto">
          <h5>Top Brands</h5>
          <canvas id="topBrandsChart"></canvas>
        </div>
      </div>

 
      <!-- Top Products -->
      <div class="row mt-5">
          <div class="col-md-6">
             <h5>Top 10 Products</h5>
          </div>
          <div class="card-body">
            <table class="table">
               <thead>
                  <tr>
                    <th>Product</th>
                    <th>Sold</th>
                  </tr>
                </thead>

                <tbody>
                  <% topProducts.forEach(p => { %>
                    <tr>
                      <td><%= p.product.productName %></td>
                      <td><%= p.totalSold %></td>
                    </tr>
                  <% }) %>
                </tbody>

            </table>
          </div>
      </div>
      <!-- Top Categories -->
      <div class="row mt-5">
          <div class="col-md-6">
             <h5>Top 10 Categories</h5>
          </div>
          <div class="card-body">
            <table class="table">
               <thead>
                  <tr>
                    <th>Product</th>
                    <th>Sold</th>
                  </tr>
                </thead>

                <tbody>
                  <% topCategories.forEach(c => { %>
                    <tr>
                      <td><%= c.category.name %></td>
                      <td><%= c.totalSold %></td>
                    </tr>
                  <% }) %>
                </tbody>

            </table>
          </div>
      </div>


      <!-- brand chart  --> 

<!-- Top Brands Table (Add after categories table) -->
<div class="row mt-5">
  <div class="col-md-6">
    <h5>Top 10 Brands</h5>
  </div>
  <div class="card-body">
    <table class="table">
      <thead>
        <tr>
          <th>Brand</th>
          <th>Units Sold</th>
        </tr>
      </thead>
      <tbody>
        <% topBrands.forEach(b => { %>
          <tr>
            <td><%= b._id %></td>
            <td><%= b.totalSold %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

    </div>
  </div>

     <script id="chart-json" type="application/json">
       {
        "products":{
          "labels":<%- JSON.stringify(topProducts.map(p=> p.product.productName)) %>,
          "values":<%- JSON.stringify(topProducts.map(p=> p.totalSold)) %>
        },
        "categories":{
          "labels":<%- JSON.stringify(topCategories.map(c=> c.category.name)) %>,
          "values":<%- JSON.stringify(topCategories.map(c=> c.totalSold)) %>
        },
        "brands":{
          "labels":<%- JSON.stringify(topBrands.map(b=> b._id)) %>,
          "values":<%- JSON.stringify(topBrands.map(b=> b.totalSold)) %>
        }
       } 
    </script>
       
  

</section>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script src="/admin/js/dashboardScript.js"></script>

<%- include("../../views/partials/admin/footer") %>
