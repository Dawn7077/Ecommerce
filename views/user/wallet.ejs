<%- include("../partials/user/header") %>

<style>
    :root {
        --primary: #4c51ff;
        --success: #0f9d58;
        --danger: #db4437;
        --info: #4285f4;
    }

    body {
        background: #f5f7fb;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .wallet-wrapper {
        max-width: 1000px;
        margin: 0 auto;
        padding: 30px 20px;
    }

    .page-header {
        margin-bottom: 30px;
    }

    .page-header h1 {
        font-size: 28px;
        font-weight: 700;
        color: #1a1a1a;
        margin: 0;
    }

    .card {
        background: white;
        border-radius: 12px;
        margin-bottom: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .card-header {
        background: #4c51ff;
        color: #fff;
        font-size: 18px;
        font-weight: 600;
        padding: 15px 20px;
        text-align: center;
    }

    .card-body {
        padding: 20px;
    }

    .balance-display {
        font-size: 28px;
        font-weight: 700;
        color: #333;
        margin-bottom: 20px;
        text-align: center;
    }

    .balance-amount {
        color: #0f9d58;
    }

    .form-control {
        padding: 10px 12px;
        font-size: 16px;
        border-radius: 8px;
        border: 1px solid #ccc;
    }

    .btn-success {
        background: var(--primary);
        border: none;
        color: #fff;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 600;
        transition: 0.3s;
        width: 100%;
    }

    .btn-success:hover {
        background: #3b41db;
        transform: translateY(-2px);
    }
    .btn-home {
        background: #9fa1e0;
        border: none;
        color: #fff;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 600;
        transition: 0.3s;
        width: 100%;
    }

    .btn-home:hover {
        background-color:rgb(102, 105, 195);
        transform: translateY(-2px);
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
    }

    table th, table td {
        padding: 12px 8px;
        border: 1px solid #e0e0e0;
        text-align: center;
    }

    table th {
        background: #f0f0ff;
        font-weight: 600;
    }

    .text-success {
        color: #0f9d58;
    }

    .text-danger {
        color: #db4437;
    }

    .empty-state {
        text-align: center;
        padding: 50px 20px;
        background: white;
        border-radius: 12px;
        margin-top: 20px;
    }

    .empty-state i {
        font-size: 60px;
        color: #ddd;
        margin-bottom: 15px;
    }

    .empty-state h3 {
        font-size: 20px;
        color: #666;
        margin-bottom: 8px;
    }

    .empty-state p {
        color: #999;
    }
    .page-header.breadcrumb-wrap {
        padding: 20px;
        background-color: #e4e7e7;
    }
    .back-link{
        color: #333;
    }
    .back-link:hover{
        color: #4ba2ee;
    }
</style>

 <div class="page-header breadcrumb-wrap">
        <div class="container d-flex align-items-center">
            <div class="back-link">
                <a href="/" class="back-link"></i>Home</a>
                <a href="/user-profile" class="back-link"><i class="fas fa-angle-right"></i>Profile</a>
                <a href="/wallet" class="back-link"><i class="fas fa-angle-right"></i>Wallet</a>
            </div>
        </div>
    </div>

<div class="wallet-wrapper">
    <div class="page-header d-flex justify-content-between">
        <h1><i class="fas fa-wallet"></i> My Wallet</h1> 
        <a href="/user-profile" class="btn btn-home" style="width: 90px;">Profile</a>
    </div>

    <!-- Wallet Balance -->
    <div class="card">
        <div class="card-header" style="color: #525252;">Available Balance</div>
        <div class="card-body">
            <div class="balance-display">
                ₹ <span class="balance-amount"><%= wallet.balance.toFixed(2) %></span>
            </div>

            <!-- Add Money Form -->
            <form method="POST" action="/wallet/add-money" id="wallet-form" style="max-width: 400px; margin: auto;">
                <label for="amount" class="form-label">Enter Amount</label>
                <input type="number" name="amount" min="50" max="9999999" class="form-control mb-3" placeholder="₹ 0.00" required>
                <button class="btn btn-success" type="submit">Add Money</button>
            </form>

            <script>
                document.getElementById('wallet-form').addEventListener('submit',async(e)=>{
                    e.preventDefault()
                    
                    const amount = e.target.amount.value

                    const res = await fetch('/wallet/add-money',{
                        method:'POST',
                        headers:{"Content-type":"application/json"},
                        body:JSON.stringify({amount})
                    })
                    const data = await res.json()
                    if(data.success){
                        window.location.href = data.url
                    }else{
                        swal('Error','Something went wrong','error')
                    }
                })
            </script>

        </div>
    </div>

    <!-- Transaction History -->
    <div class="card">
        <div class="card-header" style="color: #525252;;">Recent Transactions</div>
        <div class="card-body">
            <% if (wallet.transactions.length === 0) { %>
                <div class="empty-state">
                    <i class="fas fa-exchange-alt"></i>
                    <h3>No transactions yet</h3>
                    <p>All your wallet activity will appear here.</p>
                </div>
            <% } else { %>
                <table>
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Type</th>
                            <th>Amount</th>
                            <th>Reason</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% wallet.transactions.slice().reverse().slice(0,5).forEach(t => { %>
                        <tr>
                            <td><%= new Date(t.date).toLocaleDateString('en-IN', { day:'numeric', month:'short', year:'numeric' }) %></td>
                            <td class="<%= t.type === 'credit' ? 'text-success' : 'text-danger' %>"><%= t.type %></td>
                            <td>₹ <%= t.amount.toFixed(2) %></td>
                            <td><%= t.reason %></td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } %>
        </div>
    </div>
</div>

<%- include("../partials/user/footer") %>
