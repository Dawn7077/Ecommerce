    <div class="container mt-5 mb-1" style="
        padding-top: 70px;">
      <div class="row justify-content-center">
        <div class="col-md-8">
          <div class="card">
            <div class="card-body signup-section">
              
              <div class="signup-image">
                <a href="/">
                  <img src="/img/basepage.png" alt="Shopping Site" />
                </a>
                <div class="text-center mt-2">
                  <a href="/login" class="sign-in-link"
                    >Already registered? Log in</a
                  >
                </div>
              </div>
              
              <div class="signup-form">
                <h3 class="card-title text-center">Sign Up</h3>

                <style>
                  .inputstyle{border:none; border-bottom: 2px solid #f56358; background-color: white;}
                </style>

                <form id="signform" method="POST" action="/signup" >
                  <div class="form-group">
                    <label for="name">Full Name</label>
                    <input 
                      type="text"
                      class="form-control inputstyle"
                      name="name"
                      id="name"
                      placeholder="Enter Name"
                    />
                    <div class="error-message" id="error1"></div>
                  </div>
                  <div class="form-group">
                    <label for="email">Email address</label>
                    <input
                      type="email"
                      class="form-control inputstyle"
                      name="email"
                      id="email"
                      placeholder="Enter email"
                    />
                    <div class="error-message" id="error2"></div>
                  </div>
                  <div class="form-group">
                    <label for="phone">Phone Number</label>
                    <input
                      type="text"
                      class="form-control inputstyle"
                      name="phone"
                      id="phone"
                      placeholder="Enter phone number"
                    />
                    <div class="error-message" id="error3"></div>
                  </div>
                  <div class="form-group position-relative">
                    <label for="password">Password</label>
                    <input
                      type="password"
                      style="background-color: white;"
                      class="form-control inputstyle"
                      name="password"
                      id="password"
                      placeholder="Password"
                    />
                    <i class="fa fa-eye toggle-password mt-3"
                        onclick="togglePassword('password', this)"
                        style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); cursor: pointer; color: #6c757d;"></i>
                   
                    <div class="error-message" id="error4"></div>
                  </div>
                    
                  <div class="form-group position-relative">
                    <label for="confirm-password">Confirm Password</label>
                    <input
                      type="password"
                      class="form-control inputstyle"
                      name="cPassword"
                      id="confirm-password"
                      placeholder="Confirm Password"
                    />
                    <i class="fa fa-eye toggle-password mt-3"
                        onclick="togglePassword('confirm-password', this)"
                        style="position: absolute; right: 10px; top: 50%; transform: translateY(-50%); cursor: pointer; color: #6c757d;"></i>
                   
                    <div class="error-message" id="error5"></div>
                  </div>
                  <% if(locals.message && message.length>0){ %>
                      <div class="alert alert-danger text-center">
                        <%=message %>
                      </div>
                    <% } %>
                    <button type="submit" class="btn btn-primary" style="width: 335px;">
                    Create Account
                    </button> 
                  <div
                    class="d-flex justify-content-center   align-items-center"
                  >
                    
                    <div class="social-btns">
                      <a href="/auth/google" class="btn btn-outline-danger">
                        <img
                          src="/img/google-Iconpng.png"
                          alt="Google Logo"
                          style="width: 34px; height: 34px ;border:none"
                        /> log in with Google
                      </a>
                    </div>
                    

                    <!-- <div class="text-center">
                  <button type="submit" class="btn btn-primary w-100 mb-3">Sign Up</button>
                  <p>or sign up with</p>
                  <div class="social-btns">
                    <a href="/auth/google" class="btn-google">
                      <img src="/img/google-Iconpng.png" alt="Google">
                    </a>
                  </div>
                </div> -->
                  </div>
                  
                </form>
