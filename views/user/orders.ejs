<%- include("../partials/user/header") %>

<style>
    :root {
        --primary: #3399cc;
        --success: #0f9d58;
        --warning: #f4b400;
        --danger: #db4437;
        --info: #4285f4;
    }

    body {
        background: #f5f7fa;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .orders-wrapper {
        max-width: 1200px;
        margin: 0 auto;
        padding: 30px 20px;
    }

    .page-header {
        margin-bottom: 30px;
    }

    .page-header h1 {
        font-size: 28px;
        font-weight: 700;
        color: #1a1a1a;
        margin: 0;
    }

    .order-card {
        background: white;
        border-radius: 12px;
        margin-bottom: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .order-card:hover {
        box-shadow: 0 4px 16px rgba(0,0,0,0.12);
        transform: translateY(-2px);
    }

    .order-header {
        background: #f8f9fa;
        padding: 16px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #e9ecef;
    }

    .order-info {
        display: flex;
        gap: 30px;
        align-items: center;
    }

    .order-id {
        font-size: 14px;
        color: #666;
    }

    .order-id strong {
        color: #1a1a1a;
        font-weight: 600;
    }

    .order-date {
        font-size: 13px;
        color: #888;
    }

    .order-status-badge {
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .status-pending {
        background: #fff3cd;
        color: #856404;
    }

    .status-processing {
        background: #d1ecf1;
        color: #0c5460;
    }

    .status-shipped {
        background: #cce5ff;
        color: #004085;
    }

    .status-delivered {
        background: #d4edda;
        color: #155724;
    }

    .status-cancelled {
        background: #f8d7da;
        color: #721c24;
    }
    .status-returned {
        background: #fff3cd;
        color: #856404;
    }


    .order-body {
        padding: 20px;
    }

    .order-items-grid {
        display: flex;
        gap: 12px;
        margin-bottom: 16px;
        flex-wrap: wrap;
    }

    .item-thumbnail {
        width: 70px;
        height: 70px;
        border-radius: 8px;
        object-fit: cover;
        border: 1px solid #e9ecef;
    }

    .more-items {
        width: 70px;
        height: 70px;
        border-radius: 8px;
        background: #f8f9fa;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        font-weight: 600;
        color: #666;
        border: 1px solid #e9ecef;
    }

    .order-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: 16px;
        border-top: 1px solid #e9ecef;
    }

    .order-total {
        font-size: 20px;
        font-weight: 700;
        color: #1a1a1a;
    }

    .order-items-count {
        font-size: 13px;
        color: #888;
        margin-top: 4px;
    }

    .view-details-btn {
        padding: 10px 24px;
        background: var(--primary);
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        transition: all 0.3s ease;
    }

    .view-details-btn:hover {
        background: #2980b9;
        transform: translateX(4px);
    }

    .empty-state {
        text-align: center;
        padding: 80px 20px;
        background: white;
        border-radius: 12px;
    }

    .empty-state i {
        font-size: 72px;
        color: #ddd;
        margin-bottom: 20px;
    }

    .empty-state h3 {
        font-size: 22px;
        color: #666;
        margin-bottom: 12px;
    }

    .empty-state p {
        color: #999;
        margin-bottom: 24px;
    }

    .shop-now-btn {
        padding: 12px 32px;
        background: var(--primary);
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
    }
    .pagination-container {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin: 20px 0;
    }

    .page-btn {
        padding: 6px 12px;
        text-decoration: none;
        border: 1px solid #ccc;
        color: #333;
        border-radius: 5px;
        font-size: 14px;
        background: #f8f8f8;
    }

    .page-btn:hover {
        background: #eaeaea;
    }

    .page-btn.active {
        background: #007bff;
        color: white;
        border-color: #007bff;
    }

    
    .retry-section {
        background: #fff3cd;
        padding: 12px;
        border-radius: 8px;
        margin-bottom: 12px;
        text-align: center;
    }
    
    .retry-btn {
        padding: 10px 24px;
        background: #28a745;
        color: white;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
    }
    
    .retry-btn:hover {
        background: #218838;
        transform: scale(1.05);
    }

</style>

<div class="orders-wrapper">
    <div class="page-header">
        <h1><i class="fas fa-box"></i> My Orders</h1>
    </div>

    <% if (orders && orders.length > 0) { %>
        <% orders.forEach(order => { %>
            <div class="order-card">
                <div class="order-header">
                    <div class="order-info">
                        <div class="order-id">
                            Order <strong>#<%= order.orderId || order._id.toString().slice(-8).toUpperCase() %></strong>
                        </div>
                        <div class="order-date">
                            <i class="far fa-calendar"></i>
                            <%= new Date(order.createdAt).toLocaleDateString('en-IN', { 
                                day: 'numeric', 
                                month: 'short', 
                                year: 'numeric' 
                            }) %>
                        </div>
                    </div>
                    <span class="order-status-badge status-<%= order.status.toLowerCase() %>">
                        <%= order.status %>
                    </span>
                </div>

                <div class="order-body">
                    <% if(order.status === 'Cancelled') {%>
                        <div class="retry-section">
                            <p style="margin:0 0 8px; color: #856404; font-weight: 600;">
                                <i class="fas fa-info-circle">This order was cancelled</i>
                            </p>
                            <button class="retry-btn" onclick="retryOrder('<%= order._id %>')">
                                <i class="fas fa-redo"></i> Retry Order
                            </button>
                        </div>
                    <% } %>



                    <div class="order-items-grid">
                        <% order.orderedItems.slice(0, 4).forEach(item => { %>
                            <img src="/uploads/product-image/<%= item.productImage %>" 
                                 alt="<%= item.productName %>" 
                                 class="item-thumbnail">
                        <% }) %>
                        <% if (order.orderedItems.length > 4) { %>
                            <div class="more-items">
                                +<%= order.orderedItems.length - 4 %>
                            </div>
                        <% } %>
                    </div>

                    <div class="order-footer">
                        <div>
                            <div class="order-total">₹<%= order.finalAmount.toFixed(2) %></div>
                            <div class="order-items-count">
                                <%= order.orderedItems.length %> item<%= order.orderedItems.length > 1 ? 's' : '' %>
                            </div>
                        </div>
                        <a href="/order/<%= order._id %>" class="view-details-btn">
                            View Details
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    </div>
                </div>
            </div>
        <% }) %>
    <% } else { %>
        <div class="empty-state">
            <i class="fas fa-shopping-bag"></i>
            <h3>No orders yet</h3>
            <p>Start shopping to see your orders here</p>
            <a href="/" class="shop-now-btn">
                <i class="fas fa-shopping-cart"></i> Start Shopping
            </a>
        </div>
    <% } %>

    <div class="pagination-container">
        <% if (currentPage > 1) { %>
            <a class="page-btn" href="?page=<%= currentPage - 1 %>">Prev</a>
        <% } %>

        <% for (let i = 1; i <= totalPages; i++) { %>
            <a class="page-btn <%= currentPage === i ? 'active' : '' %>" 
            href="?page=<%= i %>"><%= i %></a>
        <% } %>

        <% if (currentPage < totalPages) { %>
            <a class="page-btn" href="?page=<%= currentPage + 1 %>">Next</a>
        <% } %>
    </div>

</div>
<!-- retry modal  -->
 <div id="retryModal" class="modal" style="display: none;">
     <div class="modal-content" style="max-width: 450px; margin: 100px auto;">
        <span class="close" onclick="closeRetryModal()">&times;</span>
        <h3>Retry Order Payment</h3>
        <p>Select Payment method to retry this order :</p>

        <div id="orderSummary" style="background: #f8f9fa; padding: 12px; border-radius: 8px; margin: 16px 0;">

        </div>
        <div style="margin: 16px 0;">
            <label style="display: block; margin-bottom: 8px; font-weight: 600;">Payment Method:</label>
            <select id="retryPaymentMethod" style="width: 100%; padding: 10px; border-radius: 6px; border: 1px solid #ccc;">
                <option value="Wallet">Wallet</option>
                <option value="Stripe">Stripe (Card Payment)</option>
            </select>
        </div>

        <button class="btn btn-primary" style="width: 100%; padding: 12px;" onclick="confirmRetry()">
            Proceed to Payment
        </button>
     </div>
 </div>

 <style>
    .modal {
        position: fixed;
        z-index: 9999;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.5);
    }

    .modal-content {
        background: white;
        padding: 24px;
        border-radius: 12px;
        position: relative;
    }

    .close {
        position: absolute;
        right: 16px;
        top: 12px;
        font-size: 28px;
        cursor: pointer;
    }
</style>

<script>
    let selectOrderId = null

    async function retryOrder(orderId) {
        selectOrderId = orderId
        try {
            const response = await fetch(`/retry-order-details/${orderId}`)
            const data = await response.json()

            if(!data.success){
                swal("Error",data.message,'error')
                return
            }
            const order = data.order
            console.log(order)

            document.getElementById('orderSummary').innerHTML = `
                <div><strong>Order ID:</strong> ${order.orderId}</div>
                <div><strong>Items:</strong> ${order.orderedItems.length} items</div>
                <div><strong>Total Amount:</strong> ₹${order.finalAmount.toFixed(2)}</div>
            `

            document.getElementById('retryModal').style.display = 'block'
        } catch (error) {
            console.log('Error fetching order:',error)
            swal('Error','Failed to load order details ','error')
        }
    }

    function closeRetryModal(){ 
            document.getElementById('retryModal').style.display = 'none'
            selectOrderId =null
    }

    async function confirmRetry() {
        const paymentMethod = document.getElementById('retryPaymentMethod').value

        if(!selectOrderId || !paymentMethod){
            swal("Error", 'Please select a payment method','warning')
            return
        }
        try {
            const response = await fetch('/retry-cancelled-order',{
                method:'POST',
                headers:{"Content-type":'application/json'},
                body:JSON.stringify({
                    orderId:selectOrderId,
                    paymentMethod:paymentMethod
                })
            })
            
            const data = await response.json()

            if(!data.success){
                if(data.redirect){ 
                    swal("Error", data.message, "error")
                    .then(()=> window.location.href = data.redirect)
                }else{
                    swal("Error", data.message, "error")
                }
                return
            }

            if(paymentMethod === 'Wallet'){
                swal("Success", "Order retried successfully with Wallet!", "success")
                .then(()=> window.location.href =`/order/success?orderId=${data.orderId}`)
            }else if(paymentMethod === 'Stripe'){  

                const stripeRes = await fetch('/payment/stripe/create-session',{
                    method:'POST',
                    headers:{"Content-type":'application/json'},
                    body:JSON.stringify({ orderId:data.orderId })
                })

                const stripeData = await stripeRes.json()

                if(stripeData.success && stripeData.url){
                    window.location.href = stripeData.url
                }else{
                    swal('Payment Error',stripeData.message || 'Failed to create a payment session','error')
                }
  
            } 

        } catch (error) { 
            console.error('Retry error:', error);
            swal("Error", "Failed to retry order", "error");
        }
    }

    window.onclick = function(event){
        const modal = document.getElementById('retryModal')
        if(event.target === modal){
            closeRetryModal()
        }
    }
</script>
<%- include("../partials/user/footer") %>