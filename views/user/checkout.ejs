 <%- include("../../views/partials/user/header") %>
 

 

    <style>
        #myDropdown {
            pointer-events: auto !important;
            cursor: pointer !important;
        }

        .payment-method select {
            position: relative;
            z-index: 10;
        }
        :root {
            --brand: #3399cc;
            --muted: #666;
            --card-bg: #ffffff;
            --surface: #f8f9fa;
            --radius: 10px;
            --max-width: 1320px;
            --shadow: 0 2px 12px rgba(0,0,0,0.06);
            font-family: "Nunito Sans", system-ui;
        }

        body {
            background: #f4f6f8;
            color: #222;
            margin: 0;
            padding: 0 16px 40px;
        }
        .site-container { max-width: var(--max-width); margin: 28px auto; }

        .breadcrumb { color: var(--muted); font-size: 14px; margin-bottom: 18px; display:flex; gap:8px; }
        .breadcrumb a { color: var(--brand); text-decoration: none; }

        h2.page-title { margin: 8px 0 22px; color: #222; font-weight:700; }

        .checkout-container {
            display: grid;
            grid-template-columns: 1fr 380px;
            gap: 28px;
        }

        .checkout-section {
            background: var(--card-bg);
            border-radius: var(--radius);
            box-shadow: var(--shadow);
            margin-bottom: 18px;
        }

        .section-header {
            background: var(--surface);
            padding: 16px 18px;
            border-bottom: 1px solid #e9ecef;
            display:flex;
            justify-content:space-between;
            align-items:center;
        }
        #myDropdown {
    pointer-events: auto !important;
    appearance: auto !important;
}
 

        .section-content { padding: 18px; }

        /* Address Card */
        .address-card {
            border:1px solid #e9ecef;
            border-radius:8px;
            padding:14px;
            margin-bottom:12px;
            cursor:pointer;
            background:white;
            transition:0.15s;
        }
        .address-card.selected { border-color:var(--brand); background:#e9f7ff; }
        .address-title { font-weight:700; color:#222; }
        .address-line { font-size:14px; color:var(--muted); }

        .btn { padding:8px 12px; font-weight:600; border-radius:6px; cursor:pointer; font-size:14px; border:none; }
        .btn-outline { background:none; color:var(--brand); border:1px solid var(--brand); }
        .btn-danger { background:none; color:#dc3545; border:1px solid #dc3545; }
        .btn-primary { background:var(--brand); color:white; }

        .payment-method { border:1px solid #e9ecef; padding:12px; border-radius:8px; display:flex; flex-direction: column;  gap:12px; margin-bottom:10px; cursor:pointer; transition:.15s; }
        .payment-method.selected { border-color:var(--brand); background:#e9f7ff; }

        /* Items */
        .checkout-item { display:flex; gap:14px; border-bottom:1px solid #ececec; padding:12px 0; }
        .item-image img { width:80px; height:80px; border-radius:8px; object-fit:cover; }
        .item-name { font-weight:700; }
        .item-price { font-weight:800; color:var(--brand); }

        /* Summary */
        .order-summary { background:white; padding:18px; border-radius:var(--radius); box-shadow:var(--shadow); position:sticky; top:20px; }
        .summary-row { display:flex; justify-content:space-between; margin-bottom:12px; }
        .summary-row.total { border-top:1px solid #e9ecef; padding-top:12px; font-weight:800; font-size:18px; }

        .place-order-btn {
            width:100%; padding:14px; background:var(--brand); color:white;
            border:none; border-radius:8px; font-size:16px; font-weight:700;
            margin-top:10px; cursor:pointer;
        }

        /* Modal overlay */
            .modal {
            display: none; 
            position: fixed; 
            z-index: 9999; 
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            overflow: auto; 
            background-color: rgba(0,0,0,0.4);
            }

            /* Modal content */
            .modal-content {
            background-color: #fff;
            margin: 60px auto;
            padding: 20px 30px;
            border-radius: 10px;
            width: 400px;
            max-width: 90%;
            position: relative;
            box-shadow: 0 4px 20px rgba(0,0,0,0.2);
            }

            /* Close button */
            .modal .close {
            color: #aaa;
            position: absolute;
            top: 12px;
            right: 16px;
            font-size: 24px;
            font-weight: bold;
            cursor: pointer;
            }

            .modal .close:hover {
            color: #000;
            }

            /* Form fields */
            .modal .form-group {
            margin-bottom: 12px;
            }

            .modal .form-group label {
            font-weight: 600;
            display: block;
            margin-bottom: 4px;
            }

            .modal .form-group input {
            width: 100%;
            padding: 6px 10px;
            border-radius: 6px;
            border: 1px solid #ccc;
            }

            .address-actions{
                margin-top: 12px;
                display: flex;
                gap: 8px;
            }
            .btn-sm{
                padding: 6px 10px;
                font-size: 12px;
            }
            .coupon-section {
    background: var(--surface);
    padding: 12px;
    border-radius: 8px;
    margin-bottom: 16px;
    border: 1px solid #e9ecef;
}

    .coupon-item {
        background: white;
        padding: 10px;
        border-radius: 8px;
        border: 1px solid #e9ecef;
        margin-bottom: 10px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .coupon-item.applied {
        background: #e6faff;
        border-color: var(--brand);
    }

    .coupon-code {
        color: var(--brand);
        font-weight: 700;
    }


    .error-message {
        color: red;
        font-size: 12px;
        margin-top: 4px;
    }

    .is-invalid {
        border-color: red !important;
    }




        </style>
 

<body>

<div class="site-container">

    <!-- Breadcrumb -->
    <nav class="breadcrumb">
        <a href="/">Home</a> › 
        <a href="/cart">Cart</a> › 
        <span>Checkout</span>
    </nav>

    <h2 class="page-title">Checkout</h2>

    <div class="checkout-container">

        <!-- LEFT SIDE -->
        <div>

            <!-- Address Section -->
            <div class="checkout-section">
                <div class="section-header">
                    <h3><i class="fas fa-map-marker-alt"></i> Shipping Address</h3>
                   <button class="btn btn-outline" onclick="openModal()"><i class="fas fa-plus"></i> Add New</button>

                </div>

                <div class="section-content">

                    <% if (addresses && addresses.length > 0) { %>
                        <% addresses.forEach((addr, i) => { %>
                            <div class="address-card <%= i === 0 ? 'selected' : '' %>" 
                                 data-address-id="<%= addr._id %>"
                                 data-address='<%= JSON.stringify(addr) %>'
                                 onclick="selectAddress('<%= addr._id %>')">

                                <div class="address-title"><%= addr.name %> (<%= addr.addressType %>)</div>
                                <div class="address-line"><%= addr.phone %></div>
                                <div class="address-line">
                                    <%= addr.landMark %>, 
                                    <%= addr.city %>, 
                                    <%= addr.state %> - <%= addr.pincode %>
                                </div>
                                <div class="address-actions">
                                    <button class="btn btn-outline btn-sm" onclick="event.stopPropagation();editAddress('<%= addr._id %>')">
                                        <i class="fas fa-edit"></i> Edit</button>
                                    <button class="btn btn-danger btn-sm"  onclick="event.stopPropagation();deleteAddress('<%= addr._id %>')">
                                        <i class="fas fa-trash"></i> Delete</button>
                                </div>


                            </div>
                        <% }) %>
                    <% } else { %>

                        <p style="color:var(--muted)">No saved addresses.</p>
                        <!-- <a href="/add-address" class="btn btn-primary" style="margin-top:8px">Add Address</a> -->
                        <button class="btn btn-primary btn-outline" onclick="openModal()"><i class="fas fa-plus"></i> Add Address</button>

                    <% } %>

                </div>
            </div>

            <!-- Payment Section -->
              

            <div class="checkout-section">
                <div class="section-header">
                    <h3><i class="fas fa-credit-card"></i> Payment Method</h3>
                </div>

                <div class="section-content">
                    <div class="payment-method selected" data-payment="cod" onclick="selectPayment('cod')">
                        <div><i class="fas fa-money-bill-wave"></i></div>
                        <div>
                            <div style="font-weight:700">Cash on Delivery</div>
                            <div style="font-size:13px;color:var(--muted)">Pay on delivery</div>
                        </div>
                    </div>
                    <div class="payment-method " data-payment="Stripe" onclick="selectPayment('Stripe')">
                        <div><i class="fas fa-money-bill-wave"></i></div>
                        <div>
                            <div style="font-weight:700">Stripe</div>
                            <div style="font-size:13px;color:var(--muted)">Pay on delivery</div>
                        </div>
                    </div>
                    <div class="payment-method " data-payment="Wallet" onclick="selectPayment('Wallet')">
                        <div><i class="fas fa-money-bill-wave"></i></div>
                        <div>
                            <div style="font-weight:700">Wallet</div>
                            <div style="font-size:13px;color:var(--muted)">Pay on delivery</div>
                        </div>
                    </div> 
                    
                    <!-- <div class="payment-method" data-payment="online" onclick="selectPayment('online')">
                        <div><i class="fas fa-credit-card"></i></div>
                        <div>
                            <div style="cursor:pointer;font-weight:700">Online Payment</div>
                            <div onclick="event.stopPropagation()">
                                <select id="myDropdown" name="mySelection" class="form-select-sm btn-sm">
                                    <option value="Creditcard">Creditcard</option>
                                    <option value="Stripe">Stripe</option>
                                    <option value="Wallet">Wallet</option>
                                </select>
                            </div>
                            <div style="font-size:13px;color:var(--muted)">Pay securely</div>
                        </div>
                    </div> -->
                
                
                </div>
            </div>

            <!-- Items Section -->
            <div class="checkout-section">
                <div class="section-header">
                    <h3><i class="fas fa-shopping-bag"></i> Order Items (<%= itemCount %>)</h3>
                </div>

                <div class="section-content">
                    <% if (cart && cart.length > 0) { %>
                    <% cart.forEach(item => { %>
                        <div class="checkout-item">
                            <div class="item-image">
                                <img src="/uploads/product-image/<%= item.productId.productImage[0] %>" />
                            </div>

                            <div>
                                <p class="item-name"><%= item.productId.productName %></p>
                                <p style="color:var(--muted);font-size:14px">Qty: <%= item.quantity %></p>
                                <p class="item-price">₹<%= item.price * item.quantity %></p>
                            </div>
                        </div>
                    <% }) %>
                    <% }else{ %>
                         <p style="color:var(--muted)">Your cart is empty.</p>
                    <% } %>

                </div>
            </div>

            

        </div>

        <!-- RIGHT PAYMENT SIDE SUMMARY -->
        <div class="order-summary">

            <!-- Coupon Section  -->
            <div class="coupon-section">
                <% if(appliedCoupon) { %>
                    <!-- applied coupon -->
                    <h4 style="margin: 0 0 10px; font-size: 14px; font-weight: 700;">
                        <i class="fas fa-ticket-alt"></i> Applied Coupon
                    </h4>
                    <div class="coupon-item applied">
                        <div>
                            <div class="coupon-code"><%= appliedCoupon.name %></div>
                            <div style="font-size:13px;color:#155724">You saved ₹<%= couponDiscount %></div>
                        </div>
                        <button class="btn btn-outline btn-sm" onclick="removeCoupon()">Remove</button>
                    </div>
                <% } else { %>
                    <!-- Show coupon input and available coupons -->
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
                        <div style="font-weight:700; display:flex; gap:8px; align-items:center;">
                            <i class="fas fa-ticket-alt"></i> Apply Coupon
                        </div>
                    </div>
                    
                    <div style="display:flex;gap:8px;margin-bottom:12px">
                        <input id="couponInput" type="text" placeholder="Enter code" 
                            style="flex:1;padding:8px;border-radius:6px;border:1px solid #e9ecef" />
                        <button class="btn btn-primary btn-sm" onclick="applyCouponCode()">Apply</button>
                    </div>
                    
                    <div id="couponList">
                        <% coupons.forEach(coupon => { %>
                            <div class="coupon-item">
                                <div>
                                    <div class="coupon-code"><%= coupon.name %></div>
                                    <div style="font-size:13px;color:var(--muted)">
                                        ₹<%= coupon.offerPrice %> off on orders above ₹<%= coupon.minimumPrice %>
                                    </div>
                                </div>
                                <button class="btn btn-primary btn-sm" 
                                        onclick="applyCouponCode('<%= coupon.name %>', event)">
                                    Apply
                                </button>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </div>


            <h3 style="font-weight:600; margin-bottom: 10px;margin-top: 20px;">Order Summary</h3>

            <div class="summary-row"><span>Subtotal</span><span>₹<%= subtotal %></span></div>
            <div class="summary-row"><span>Product Offer</span><span  style="color: #d8514a;">-₹<%= discount %></span></div>
            <% if(couponDiscount >0) {%>
            <div class="summary-row"><span>Coupon Discount</span><span  style="color: #d8514a;">-₹<%= couponDiscount %></span></div>
            <% } %>
            <div class="summary-row"><span>Shipping</span><span><%= shipping === 0 ? "Free" : "₹" + shipping %></span></div>

            <div class="summary-row total"><span>Total</span><span style="color: #B88E2F;">₹<%= total %></span></div>

            <button class="place-order-btn" id="placeOrderBtn" onclick="placeOrder()">Place Order</button>

        </div>

    </div>
</div>
<!-- Add Address Modal -->
