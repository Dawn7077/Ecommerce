 <%- include("../../views/partials/user/header") %>
 

 <link rel="stylesheet" href="/user/Style/checkout.css">


<body>

<div class="site-container">

    <!-- Breadcrumb -->
    <nav class="breadcrumb">
        <a href="/">Home</a> › 
        <a href="/cart">Cart</a> › 
        <span>Checkout</span>
    </nav>

    <h2 class="page-title">Checkout</h2>

    <div class="checkout-container">

        <!-- LEFT SIDE -->
        <div>

            <!-- Address Section -->
            <div class="checkout-section">
                <div class="section-header">
                    <h3><i class="fas fa-map-marker-alt"></i> Shipping Address</h3>
                   <button class="btn btn-outline" onclick="openModal()"><i class="fas fa-plus"></i> Add New</button>

                </div>

                <div class="section-content">

                    <% if (addresses && addresses.length > 0) { %>
                        <% addresses.forEach((addr, i) => { %>
                            <div class="address-card <%= i === 0 ? 'selected' : '' %>" 
                                 data-address-id="<%= addr._id %>"
                                 data-address='<%= JSON.stringify(addr) %>'
                                 onclick="selectAddress('<%= addr._id %>')">

                                <div class="address-title"><%= addr.name %> (<%= addr.addressType %>)</div>
                                <div class="address-line"><%= addr.phone %></div>
                                <div class="address-line">
                                    <%= addr.landMark %>, 
                                    <%= addr.city %>, 
                                    <%= addr.state %> - <%= addr.pincode %>
                                </div>
                                <div class="address-actions">
                                    <button class="btn btn-outline btn-sm" onclick="event.stopPropagation();editAddress('<%= addr._id %>')">
                                        <i class="fas fa-edit"></i> Edit</button>
                                    <button class="btn btn-danger btn-sm"  onclick="event.stopPropagation();deleteAddress('<%= addr._id %>')">
                                        <i class="fas fa-trash"></i> Delete</button>
                                </div>


                            </div>
                        <% }) %>
                    <% } else { %>

                        <p style="color:var(--muted)">No saved addresses.</p>
                        <!-- <a href="/add-address" class="btn btn-primary" style="margin-top:8px">Add Address</a> -->
                        <button class="btn btn-primary btn-outline" onclick="openModal()"><i class="fas fa-plus"></i> Add Address</button>

                    <% } %>

                </div>
            </div>

            <!-- Payment Section -->
              

            <div class="checkout-section">
                <div class="section-header">
                    <h3><i class="fas fa-credit-card"></i> Payment Method</h3>
                </div>

                <div class="section-content">
                    <div class="payment-method selected" data-payment="cod" onclick="selectPayment('cod')">
                        <div><i class="fas fa-money-bill-wave"></i></div>
                        <div>
                            <div style="font-weight:700">Cash on Delivery</div>
                            <div style="font-size:13px;color:var(--muted)">Pay on delivery</div>
                        </div>
                    </div>
                    <div class="payment-method " data-payment="Stripe" onclick="selectPayment('Stripe')">
                        <div><i class="fas fa-money-bill-wave"></i></div>
                        <div>
                            <div style="font-weight:700">Stripe</div>
                            <div style="font-size:13px;color:var(--muted)">Pay on delivery</div>
                        </div>
                    </div>
                    <div class="payment-method " data-payment="Wallet" onclick="selectPayment('Wallet')">
                        <div><i class="fas fa-money-bill-wave"></i></div>
                        <div>
                            <div style="font-weight:700">Wallet</div>
                            <div style="font-size:13px;color:var(--muted)">Pay on delivery</div>
                        </div>
                    </div> 
                    
                    <!-- <div class="payment-method" data-payment="online" onclick="selectPayment('online')">
                        <div><i class="fas fa-credit-card"></i></div>
                        <div>
                            <div style="cursor:pointer;font-weight:700">Online Payment</div>
                            <div onclick="event.stopPropagation()">
                                <select id="myDropdown" name="mySelection" class="form-select-sm btn-sm">
                                    <option value="Creditcard">Creditcard</option>
                                    <option value="Stripe">Stripe</option>
                                    <option value="Wallet">Wallet</option>
                                </select>
                            </div>
                            <div style="font-size:13px;color:var(--muted)">Pay securely</div>
                        </div>
                    </div> -->
                
                
                </div>
            </div>

            <!-- Items Section -->
            <div class="checkout-section">
                <div class="section-header">
                    <h3><i class="fas fa-shopping-bag"></i> Order Items (<%= itemCount %>)</h3>
                </div>

                <div class="section-content">
                    <% if (cart && cart.length > 0) { %>
                    <% cart.forEach(item => { %>
                        <div class="checkout-item">
                            <div class="item-image">
                                <img src="/uploads/product-image/<%= item.productId.productImage[0] %>" />
                            </div>

                            <div>
                                <p class="item-name"><%= item.productId.productName %></p>
                                <p style="color:var(--muted);font-size:14px">Qty: <%= item.quantity %></p>
                                <p class="item-price">₹<%= item.price * item.quantity %></p>
                            </div>
                        </div>
                    <% }) %>
                    <% }else{ %>
                         <p style="color:var(--muted)">Your cart is empty.</p>
                    <% } %>

                </div>
            </div>

            

        </div>

        <!-- RIGHT PAYMENT SIDE SUMMARY -->
        <div class="order-summary">

            <!-- Coupon Section  -->
            <div class="coupon-section">
                <% if(appliedCoupon) { %>
                    <!-- applied coupon -->
                    <h4 style="margin: 0 0 10px; font-size: 14px; font-weight: 700;">
                        <i class="fas fa-ticket-alt"></i> Applied Coupon
                    </h4>
                    <div class="coupon-item applied">
                        <div>
                            <div class="coupon-code"><%= appliedCoupon.name %></div>
                            <div style="font-size:13px;color:#155724">You saved ₹<%= couponDiscount %></div>
                        </div>
                        <button class="btn btn-outline btn-sm" onclick="removeCoupon()">Remove</button>
                    </div>
                <% } else { %>
                    <!-- Show coupon input and available coupons -->
                    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:10px">
                        <div style="font-weight:700; display:flex; gap:8px; align-items:center;">
                            <i class="fas fa-ticket-alt"></i> Apply Coupon
                        </div>
                    </div>
                    
                    <div style="display:flex;gap:8px;margin-bottom:12px">
                        <input id="couponInput" type="text" placeholder="Enter code" 
                            style="flex:1;padding:8px;border-radius:6px;border:1px solid #e9ecef" />
                        <button class="btn btn-primary btn-sm" onclick="applyCouponCode()">Apply</button>
                    </div>
                    
                    <div id="couponList">
                        <% coupons.forEach(coupon => { %>
                            <div class="coupon-item">
                                <div>
                                    <div class="coupon-code"><%= coupon.name %></div>
                                    <div style="font-size:13px;color:var(--muted)">
                                        ₹<%= coupon.offerPrice %> off on orders above ₹<%= coupon.minimumPrice %>
                                    </div>
                                </div>
                                <button class="btn btn-primary btn-sm" 
                                        onclick="applyCouponCode('<%= coupon.name %>', event)">
                                    Apply
                                </button>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </div>


            <h3 style="font-weight:600; margin-bottom: 10px;margin-top: 20px;">Order Summary</h3>

            <div class="summary-row"><span>Subtotal</span><span>₹<%= subtotal %></span></div>
            <div class="summary-row"><span>Product Offer</span><span  style="color: #d8514a;">-₹<%= discount %></span></div>
            <% if(couponDiscount >0) {%>
            <div class="summary-row"><span>Coupon Discount</span><span  style="color: #d8514a;">-₹<%= couponDiscount %></span></div>
            <% } %>
            <div class="summary-row"><span>Shipping</span><span><%= shipping === 0 ? "Free" : "₹" + shipping %></span></div>

            <div class="summary-row total"><span>Total</span><span style="color: #B88E2F;">₹<%= total %></span></div>

            <button class="place-order-btn" id="placeOrderBtn" onclick="placeOrder()">Place Order</button>

        </div>

    </div>
</div>
<!-- Add Address Modal -->
<div id="addressModal" class="modal">
  <div class="modal-content">
    <span class="close" onclick="closeModal()">&times;</span>
    <h3>Add New Address</h3>
    <form id="modalAddressForm" >
      <div class="form-group">
        <label for="addressType">Address Type:</label>
        <input type="text" id="addressType" name="addressType"  >
      </div>
      <div class="form-group">
        <label for="name">Name:</label>
        <input type="text" id="name" name="name"  >
      </div>
      <div class="form-group">
        <label for="city">City:</label>
        <input type="text" id="city" name="city"  >
      </div>
      <div class="form-group">
        <label for="landMark">Landmark:</label>
        <input type="text" id="landMark" name="landMark"  >
      </div>
      <div class="form-group">
        <label for="state">State:</label>
        <input type="text" id="state" name="state"  >
      </div>
      <div class="form-group">
        <label for="pincode">Pincode:</label>
        <input type="text" id="pincode" name="pincode"  >
        <!-- <input type="text" id="pincode" oninput="allowOnlyNumbers(event)" maxlength="6"> -->
      </div>
      <div class="form-group">
        <label for="phone">Phone:</label>
        <input type="text" id="phone" name="phone"  >
        <!-- <input type="text" id="phone" oninput="allowOnlyNumbers(event)" maxlength="10"> -->

      </div>
      <div class="form-group">
        <label for="altPhone">Alternate Phone:</label>
        <input type="text" id="altPhone" name="altPhone">
      </div>
      <button type="submit" class="btn btn-primary">Save Address</button>
    </form>
  </div>
</div> 
<!-- validate address add modal -->
<script>
    // document.getElementById("addressModal").addEventListener("submit", function (e) {
    //     e.preventDefault();
    //     if (validateAddressForm()) {
    //         this.submit();
    //     }
    // });

    function validateAddressForm() {
        const fields = [
            { id: "addressType", name: "Address Type" },
            { id: "name", name: "Name" },
            { id: "city", name: "City" },
            { id: "landMark", name: "Landmark" },
            { id: "state", name: "State" },
            { id: "pincode", name: "Pincode" },
            { id: "phone", name: "Phone" },
        ];

        let isValid = true;
    
        document.querySelectorAll(".error-message").forEach(el => el.innerHTML = "");

        fields.forEach(field => {
            const input = document.getElementById(field.id);
            const value = input.value.trim();
            const errorDiv = getErrorDiv(input);

            input.classList.remove("is-invalid");

            if (value === "") {
                errorDiv.innerHTML = `${field.name} is required`;
                input.classList.add("is-invalid");
                isValid = false;
            }
        });
    
        const pincode = document.getElementById("pincode");
        if (pincode.value && !/^[1-9][0-9]{5}$/.test(pincode.value)) {
            getErrorDiv(pincode).innerHTML = "Enter a valid 6-digit pincode";
            pincode.classList.add("is-invalid");
            isValid = false;
        }
    
        const phone = document.getElementById("phone");
        if (phone.value && !/^[6-9]\d{9}$/.test(phone.value)) {
            getErrorDiv(phone).innerHTML = "Enter a valid 10-digit phone number";
            phone.classList.add("is-invalid");
            isValid = false;
        }

        return isValid;
    }
    
    function getErrorDiv(input) {
        let errorDiv = input.parentElement.querySelector(".error-message");
        if (!errorDiv) {
            errorDiv = document.createElement("div");
            errorDiv.className = "error-message";
            input.parentElement.appendChild(errorDiv);
        }
        return errorDiv;
    }


</script>


<!-- edit Address Modal -->
<div class="modal" id="editAddressModal">
    <div class="modal-content">
        <span class="close" onclick="closeEditModal()">&times;</span>
        <h3>Edit Address</h3>
        <form id="modalEditAddressForm">
            <input type="hidden" name="addressId" id="editAddressId">

            <div class="form-group">
                <label for="editAddressType">Address Type</label>
                <input type="text" name="editAddressType" id="editAddressType"  >
            </div>
            <div class="form-group">
                <label for="editName">Name</label>
                <input type="text" name="editName" id="editName"  >
            </div>
            <div class="form-group">
                <label for="editCity">City</label>
                <input type="text" name="editCity" id="editCity"  >
            </div>
            <div class="form-group">
                <label for="editLandMark">Landmark</label>
                <input type="text" name="editLandMark" id="editLandMark"  >
            </div>
            <div class="form-group">
                <label for="editState">State</label>
                <input type="text" name="editState" id="editState"  >
            </div>
            <div class="form-group">
                <label for="editPincode">Pincode</label>
                <!-- <input type="text" name="editPincode" id="editPincode"  > -->
                <input type="text" id="editPincode" maxlength="6" oninput="allowOnlyNumbers(event)">
            </div>
            <div class="form-group">
                <label for="editPhone">Phone</label>
                <!-- <input type="text" name="editPhone" id="editPhone"  > -->
                 <input type="text" id="editPhone" maxlength="10" oninput="allowOnlyNumbers(event)">
            </div>
            <div class="form-group">
                <label for="editAltPhone">Alternate Phone</label>
                <!-- <input type="text" name="editAltPhone" id="editAltPhone"> -->
                 <input type="text" id="editAltPhone" maxlength="10" oninput="allowOnlyNumbers(event)">
                
            </div>
            <button type="submit" class="btn btn-primary">Update Address</button>
        </form>
    </div>
</div>
<!-- validate address edit modal addd -->
<script src="/user/js/checkoutScript.js"></script>



 

 
   
 

 



</body>

 
