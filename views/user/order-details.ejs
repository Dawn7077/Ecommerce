<%- include("../partials/user/header") %>

<style>
    :root {
        --primary: #3399cc;
        --success: #0f9d58;
        --warning: #f4b400;
        --danger: #db4437;
        --info: #4285f4;
    }

    body {
        background: #f5f7fa;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .order-details-wrapper {
        max-width: 1200px;
        margin: 0 auto;
        padding: 30px 20px;
    }

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #666;
        text-decoration: none;
        margin-bottom: 20px;
        font-size: 14px;
        transition: color 0.3s;
    }

    .back-link:hover {
        color: var(--primary);
    }

    .page-header {
        background: white;
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

    .order-header-content {
        display: flex;
        justify-content: space-between;
        align-items: start;
        flex-wrap: wrap;
        gap: 20px;
    }

    .order-id-section h1 {
        font-size: 24px;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 8px;
    }

    .order-meta {
        display: flex;
        gap: 20px;
        color: #666;
        font-size: 14px;
        flex-wrap: wrap;
    }

    .order-meta-item {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .order-status-section {
        text-align: right;
    }

    .status-badge {
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: inline-block;
        margin-bottom: 12px;
    }

    .status-pending { background: #fff3cd; color: #856404; }
    .status-processing { background: #d1ecf1; color: #0c5460; }
    .status-shipped { background: #cce5ff; color: #004085; }
    .status-delivered { background: #d4edda; color: #155724; }
    .status-cancelled { background: #f8d7da; color: #721c24; }
    .status-return { background: #fff3cd; color: #856404; }

    .order-actions {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }

    .btn-action {
        padding: 8px 16px;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        font-size: 14px;
        transition: all 0.3s;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .btn-cancel {
        background: #f8d7da;
        color: #721c24;
    }

    .btn-cancel:hover {
        background: #f5c6cb;
    }

    .btn-return {
        background: #fff3cd;
        color: #856404;
    }

    .btn-return:hover {
        background: #ffe8a1;
    }

    .card-section {
        background: white;
        border-radius: 12px;
        padding: 24px;
        margin-bottom: 20px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.06);
    }

    .section-title {
        font-size: 18px;
        font-weight: 700;
        color: #1a1a1a;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .section-title i {
        color: var(--primary);
    }

    /* Order Timeline */
    .order-timeline {
        position: relative;
        padding-left: 40px;
    }

    .timeline-item {
        position: relative;
        padding-bottom: 30px;
    }

    .timeline-item:last-child {
        padding-bottom: 0;
    }

    .timeline-dot {
        position: absolute;
        left: -40px;
        width: 16px;
        height: 16px;
        border-radius: 50%;
        background: #e9ecef;
        border: 3px solid white;
        box-shadow: 0 0 0 2px #e9ecef;
    }

    .timeline-dot.active {
        background: var(--success);
        box-shadow: 0 0 0 2px var(--success);
    }

    .timeline-line {
        position: absolute;
        left: -33px;
        top: 16px;
        width: 2px;
        height: 100%;
        background: #e9ecef;
    }

    .timeline-content h4 {
        font-size: 15px;
        font-weight: 600;
        color: #1a1a1a;
        margin-bottom: 4px;
    }

    .timeline-date {
        font-size: 13px;
        color: #888;
    }

    /* Items */
    .order-item {
        display: flex;
        gap: 16px;
        padding: 16px;
        border: 1px solid #e9ecef;
        border-radius: 10px;
        margin-bottom: 12px;
        transition: all 0.3s;
    }

    .order-item:hover {
        border-color: var(--primary);
        box-shadow: 0 2px 8px rgba(51,153,204,0.1);
    }

    .item-image {
        width: 100px;
        height: 100px;
        border-radius: 8px;
        object-fit: cover;
        background: #f8f9fa;
    }

    .item-details {
        flex: 1;
    }

    .item-name {
        font-size: 16px;
        font-weight: 600;
        color: #1a1a1a;
        margin-bottom: 8px;
    }

    .item-meta {
        display: flex;
        gap: 20px;
        color: #666;
        font-size: 14px;
        margin-bottom: 8px;
    }

    .item-price {
        font-size: 18px;
        font-weight: 700;
        color: var(--primary);
    }

    .item-status-badge {
        display: inline-block;
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 600;
        margin-top: 8px;
    }

    .item-actions {
        display: flex;
        gap: 8px;
        margin-top: 12px;
    }

    .btn-item-action {
        padding: 6px 12px;
        border: none;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
    }

    .btn-item-cancel {
        background: #f8d7da;
        color: #721c24;
    }

    .btn-item-return {
        background: #fff3cd;
        color: #856404;
    }

    /* Address Card */
    .address-info {
        background: #f8f9fa;
        padding: 16px;
        border-radius: 8px;
        border-left: 4px solid var(--primary);
    }

    .address-type {
        display: inline-block;
        padding: 4px 10px;
        background: var(--primary);
        color: white;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .address-name {
        font-weight: 600;
        color: #1a1a1a;
        margin-bottom: 4px;
    }

    .address-details {
        color: #666;
        font-size: 14px;
        line-height: 1.6;
    }

    /* Payment Summary */
    .summary-row {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        font-size: 15px;
        color: #666;
    }

    .summary-row.total {
        border-top: 2px solid #e9ecef;
        margin-top: 10px;
        padding-top: 15px;
        font-size: 20px;
        font-weight: 700;
        color: #1a1a1a;
    }

    /* Modal Styles */
    .modal-overlay {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0,0,0,0.5);
        z-index: 9999;
        align-items: center;
        justify-content: center;
    }

    .modal-overlay.active {
        display: flex;
    }

    .modal-content {
        background: white;
        border-radius: 16px;
        padding: 30px;
        max-width: 500px;
        width: 90%;
        max-height: 90vh;
        overflow-y: auto;
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .modal-header h3 {
        font-size: 20px;
        font-weight: 700;
        color: #1a1a1a;
    }

    .modal-close {
        background: none;
        border: none;
        font-size: 24px;
        color: #999;
        cursor: pointer;
        padding: 0;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        display: block;
        font-weight: 600;
        margin-bottom: 8px;
        color: #1a1a1a;
    }

    .form-control {
        width: 100%;
        padding: 10px 14px;
        border: 1px solid #e9ecef;
        border-radius: 8px;
        font-size: 14px;
        transition: all 0.3s;
    }

    .form-control:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(51,153,204,0.1);
    }

    textarea.form-control {
        min-height: 100px;
        resize: vertical;
    }

    .modal-actions {
        display: flex;
        gap: 12px;
        justify-content: flex-end;
    }

    .btn-modal {
        padding: 10px 24px;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        font-size: 14px;
        transition: all 0.3s;
    }

    .btn-secondary {
        background: #e9ecef;
        color: #666;
    }

    .btn-primary {
        background: var(--primary);
        color: white;
    }

    .btn-primary:hover {
        background: #2980b9;
    }

    @media (max-width: 768px) {
        .order-header-content {
            flex-direction: column;
        }

        .order-status-section {
            text-align: left;
        }

        .order-actions {
            justify-content: flex-start;
        }

        .item-meta {
            flex-direction: column;
            gap: 4px;
        }
    } 
    .swal2-container {
        z-index: 99999 !important;  
    }
    
    .modal-overlay {
        z-index: 9999;
    }
</style>

<div class="order-details-wrapper">
    <!-- Back Link -->
    <a href="/order" class="back-link">
        <i class="fas fa-arrow-left"></i>
        Back to Orders
    </a>

    <!-- Order Header -->
    <div class="page-header">
        <div class="order-header-content">
            <div class="order-id-section">
                <h1>Order #<%= order.orderId || order._id.toString().slice(-8).toUpperCase() %></h1>
                <div class="order-meta">
                    <div class="order-meta-item">
                        <i class="far fa-calendar"></i>
                        <span>
                            <%= new Date(order.createdAt).toLocaleDateString('en-IN', { 
                                day: 'numeric', 
                                month: 'long', 
                                year: 'numeric' 
                            }) %>
                        </span>
                    </div>
                    <div class="order-meta-item">
                        <i class="fas fa-credit-card"></i>
                        <span><%= order.paymentMethod.toUpperCase() %></span>
                    </div>
                    <div class="order-meta-item">
                        <i class="fas fa-box"></i>
                        <span><%= order.orderedItems.length %> item(s)</span>
                    </div>
                </div>
            </div>

            <div class="order-status-section">
                <span class="status-badge status-<%= order.status.toLowerCase() %>">
                    <%= order.status %>
                </span>
                <div class="order-actions">
                    <% if ( ['Pending', 'Processing'].includes(order.status)) { %>
                        <button class="btn-action btn-cancel" onclick="openCancelModal('order', '<%= order._id %>')">
                            <i class="fas fa-times-circle"></i>
                            Cancel Order
                        </button>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- Order Items -->
    <div class="card-section">
        <div class="section-title">
            <i class="fas fa-shopping-bag"></i>
            Order Items
        </div>

        <% order.orderedItems.forEach(item => { %>
            <div class="order-item">
                <img src="/uploads/product-image/<%= item.productImage %>" 
                     alt="<%= item.productName %>" 
                     class="item-image">
                
                <div class="item-details">
                    <div class="item-name"><%= item.productName %></div>
                    <div class="item-meta">
                        <span><i class="fas fa-shopping-cart"></i> Qty: <%= item.quantity %></span>
                        <span><i class="fas fa-tag"></i> ₹<%= item.price %> each</span>
                    </div>
                    <div class="item-price">₹<%= (item.price * item.quantity).toFixed(2) %></div>
                    
                    <% if(item.status !=='Returned'  ) {%>
                    <span class="item-status-badge status-<%= item.status.toLowerCase() %>">
                        <%= item.status %>
                    </span> 
                    <% } %>



                    <div class="item-actions">
                        <% if (['Pending', 'Processing'].includes(item.status))  {%> 
                            <button class="btn-item-action btn-item-cancel" 
                                    onclick="openCancelModal('item', '<%= order._id %>', '<%= item._id %>')">
                                <i class="fas fa-times"></i> Cancel Item
                            </button>
                        <% } else if (order.status === 'Delivered' && item.status !== 'Return Requested' &&
                            !item.statusHistory.some(h=>h.status ==='Return Rejected')  &&!item.statusHistory.some(h=>h.status ==='Returned')){ %>

                            <button class="btn-item-action btn-item-return" 
                                    onclick="openReturnModal('<%= order._id %>', '<%= item._id %>')">
                                <i class="fas fa-undo"></i> Return Item
                            </button> 
                        
                        <% }else if(item.status === 'Returned'){%>
                            <span class="item-status-badge status-return">Returned</span> 
                        <% }else if(item.statusHistory.some(h=>h.status === 'Return Rejected')){%>
                            <span class="item-status-badge status-cancelled">Return Rejected</span>

                        <% }%>
                    </div>



                </div>
            </div>
        <% }) %>
    </div>

    <!-- Order Timeline (if you want to show tracking) -->
    <div class="card-section">
        <div class="section-title">
            <i class="fas fa-route"></i>
            Order Timeline
        </div>
        <div class="order-timeline">
            <% 
            const statuses = ['Pending', 'Processing', 'Shipped', 'Delivered'];
            const currentStatusIndex = statuses.indexOf(order.status);
            %>
            <% statuses.forEach((status, index) => { %>
                <div class="timeline-item">
                    <div class="timeline-dot <%= index <= currentStatusIndex ? 'active' : '' %>"></div>
                    <% if (index < statuses.length - 1) { %>
                        <div class="timeline-line"></div>
                    <% } %>
                    <div class="timeline-content">
                        <h4><%= status %></h4>
                        <% if (index <= currentStatusIndex) { %>
                            <div class="timeline-date">
                                <%= index === 0 ? new Date(order.createdAt).toLocaleString('en-IN') : 'Processing' %>
                            </div>
                        <% } %>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
    

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
        <!-- Shipping Address -->
        <div class="card-section">
            <div class="section-title">
                <i class="fas fa-map-marker-alt"></i>
                Shipping Address
            </div>
            <div class="address-info">
                <span class="address-type"><%= order.address.addressType %></span>
                <div class="address-name"><%= order.address.name %></div>
                <div class="address-details">
                    <%= order.address.landMark %><br>
                    <%= order.address.city %>, <%= order.address.state %> - <%= order.address.pincode %><br>
                    <i class="fas fa-phone"></i> <%= order.address.phone %>
                    <% if (order.address.altPhone) { %>
                        <br><i class="fas fa-phone"></i> <%= order.address.altPhone %>
                    <% } %>
                </div>
            </div>
        </div>

        <!-- Payment Summary -->
        <div class="card-section">
            <div class="section-title">
                <i class="fas fa-receipt"></i>
                Payment Summary
                <a href="/order-invoice/<%= order._id %>" 
                    class="btn btn-primary " 
                    style="margin-left: 90px;"
                    target="_blank">
                    📄 Download Invoice
                </a>

            </div>

            <div class="summary-row">
                <span>Subtotal</span>
                <span>₹<%= order.totalPrice.toFixed(2) %></span>
            </div>
            <div class="summary-row">
                <span>Discount</span>
                <span>-₹<%= order.discount.toFixed(2) %></span>
            </div>
            <% if (order.couponApplied) { %>
                <div class="summary-row">
                    <span>Coupon Discount</span>
                    <span>-₹<%= order.couponDiscount.toFixed(2) %></span>
                </div>
            <% } %>
            <div class="summary-row">
                <span>Shipping</span>
                <span><%= order.totalPrice > 1000 ? 'FREE' : '₹100' %></span>
            </div>
            <div class="summary-row total">
                <span>Total Amount</span>
                <span>₹<%= order.finalAmount.toFixed(2) %></span>
            </div>
        </div>
    </div>
</div>

<!-- Cancel- popup Modal -->
<div id="cancelModal" class="modal-overlay">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Cancel Order</h3>
            <button class="modal-close" onclick="closeCancelModal()">×</button>
        </div>
        <form id="cancelForm">
            <input type="hidden" id="cancelType">
            <input type="hidden" id="cancelOrderId">
            <input type="hidden" id="cancelItemId">
            
            <div class="form-group">
                <label class="form-label">Reason for Cancellation*</label>
                <select id="cancelReason" class="form-control" required>
                    <option value="">Select a reason</option>
                    <option value="Changed my mind">Changed my mind</option>
                    <option value="Found better price">Found better price</option>
                    <option value="Ordered by mistake">Ordered by mistake</option>
                    <option value="Delivery time too long">Delivery time too long</option>
                    <option value="Other">Other</option>
                </select>
            </div>
            
            <div class="form-group">
                <label class="form-label">Additional Comments</label>
                <textarea id="cancelComments" class="form-control" 
                          placeholder="Provide more details (optional)"></textarea>
            </div>
            
            <div class="modal-actions">
                <button type="button" class="btn-modal btn-secondary" onclick="closeCancelModal()">
                    Cancel
                </button>
                <button type="submit" class="btn-modal btn-primary">
                    Confirm Cancellation
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Return- popup  Modal -->
<div id="returnModal" class="modal-overlay">
    <div class="modal-content">
        <div class="modal-header">
            <h3>Request Return</h3>
            <button class="modal-close" onclick="closeReturnModal()">×</button>
        </div>
        <form id="returnForm">
            <input type="hidden" id="returnOrderId">
            <input type="hidden" id="returnItemId">
            
            <div class="form-group">
                <label class="form-label">Reason for Return*</label>
                <select id="returnReason" class="form-control" required>
                    <option value="">Select a reason</option>
                    <option value="Defective product">Defective product</option>
                    <option value="Wrong item received">Wrong item received</option>
                    <option value="Not as described">Not as described</option>
                    <option value="Quality issues">Quality issues</option>
                    <option value="Changed my mind">Changed my mind</option>
                    <option value="Other">Other</option>
                </select>
            </div>
            
            <div class="form-group">
                <label class="form-label">Describe the Issue*</label>
                <textarea id="returnComments" class="form-control" 
                          placeholder="Please provide details about the issue" required></textarea>
            </div>
            
            <div style="background: #fff3cd; padding: 12px; border-radius: 8px; margin-bottom: 20px;">
                <small style="color: #856404;">
                    <i class="fas fa-info-circle"></i>
                    Returns must be requested within 7 days of delivery. 
                    Products should be unused and in original packaging.
                </small>
            </div>
            
            <div class="modal-actions">
                <button type="button" class="btn-modal btn-secondary" onclick="closeReturnModal()">
                    Cancel
                </button>
                <button type="submit" class="btn-modal btn-primary">
                    Submit Return Request
                </button>
            </div>
        </form>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    // Cancel Modal Functions
    function openCancelModal(type, orderId, itemId = null) {
        document.getElementById('cancelType').value = type;
        document.getElementById('cancelOrderId').value = orderId;
        document.getElementById('cancelItemId').value = itemId || '';
        document.getElementById('cancelModal').classList.add('active');
    }

    function closeCancelModal() {
        document.getElementById('cancelModal').classList.remove('active');
        document.getElementById('cancelForm').reset();
    }

    // Return Modal Functions
    function openReturnModal(orderId, itemId) {
        document.getElementById('returnOrderId').value = orderId;
        document.getElementById('returnItemId').value = itemId;
        document.getElementById('returnModal').classList.add('active');
    }

    function closeReturnModal() {
        document.getElementById('returnModal').classList.remove('active');
        document.getElementById('returnForm').reset();
    }

    // Cancel Form =>Submit
    document.getElementById('cancelForm').addEventListener('submit', async function(e) {
        e.preventDefault();

        const type = document.getElementById('cancelType').value;
        const orderId = document.getElementById('cancelOrderId').value;
        const itemId = document.getElementById('cancelItemId').value;
        const reason = document.getElementById('cancelReason').value;
        const comments = document.getElementById('cancelComments').value;

        const fullReason = comments ? `${reason} - ${comments}` : reason;

        closeCancelModal()

        try {
            const response = await fetch(`/cancel-order/${orderId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    itemId: itemId || null,
                    reason: fullReason
                })
            });

            const data = await response.json();

            if (data.success) {
                closeCancelModal();
                Swal.fire({
                    icon: 'success',
                    title: 'Cancelled Successfully',
                    text: data.message,
                    confirmButtonColor: '#3399cc'
                }).then(() => {
                    location.reload();
                });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Cancellation Failed',
                    text: data.message,
                    confirmButtonColor: '#3399cc'
                });
            }
        } catch (error) {
            console.error('Cancel error:', error);
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'Something went wrong. Please try again.',
                confirmButtonColor: '#3399cc'
            });
        }
    });

    // Return Form =>Submit
    document.getElementById('returnForm').addEventListener('submit', async function(e) {
        e.preventDefault();

        const orderId = document.getElementById('returnOrderId').value;
        const itemId = document.getElementById('returnItemId').value;
        const reason = document.getElementById('returnReason').value;
        const comments = document.getElementById('returnComments').value;

        const fullReason = `${reason} - ${comments}`;
        closeReturnModal()

        try {
            const response = await fetch(`/return-order/${orderId}`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    itemId,
                    reason: fullReason
                })
            });

            const data = await response.json();

            if (data.success) {
                closeReturnModal();
                Swal.fire({
                    icon: 'success',
                    title: 'Return Request Submitted',
                    text: data.message,
                    confirmButtonColor: '#3399cc'
                }).then(() => {
                    location.reload();
                });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Request Failed',
                    text: data.message,
                    confirmButtonColor: '#3399cc'
                });
            }
        } catch (error) {
            console.error('Return error:', error);
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'Something went wrong. Please try again.',
                confirmButtonColor: '#3399cc'
            });
        }
    });

    // Close modals when clicking outside
    document.getElementById('cancelModal').addEventListener('click', function(e) {
        if (e.target === this) {
            closeCancelModal();
        }
    });

    document.getElementById('returnModal').addEventListener('click', function(e) {
        if (e.target === this) {
            closeReturnModal();
        }
    });
</script>

