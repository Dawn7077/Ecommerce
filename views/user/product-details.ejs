      <div style="max-width: 600px; width: 100%;">
      <h4  style="margin-left: 165px;">Reviews</h4> 

      <div class="reviewContainer mt-3 d-flex flex-column gap-3" style="margin-left: 165px;">
        <div class="review-Card mb-3 p-3 border rounded  ">
          <strong>John Doe</strong> - <span>⭐⭐⭐⭐⭐</span>
          <p>Great product! Really loved it.</p>
        </div>
        <div class="review-Card mb-3 p-3 border rounded  ">
          <strong>Sam Peter</strong> - <span>⭐⭐⭐⭐⭐</span>
          <p>Great product! Really loved it.</p>
        </div>
      </div>
      </div>
    </div>
  </div>




 <section class="recommended-product m-4">
  <div class="container">
    <div class="row">
      <div class="col-lg-12 d-flex justify-content-start">
        <h3>Recommended for you</h3>
      </div>
    </div>
    <div class="row product__filter d-flex justify-content-center">
      <% for(let i = 0; i < recommendedProducts.length; i++) { %>
