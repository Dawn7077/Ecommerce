<%- include("../../views/partials/user/header") %>
<%- include("../../views/partials/user/crumbs") %>

<head>
  <link rel="stylesheet" href="/user-assets/css/plugins/slick.css" />
  <link rel="stylesheet" href="/user-assets/css/plugins/slick-theme.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css"/>
  <style>
    /* --- Product Page Styling --- */
    .product-page {
      max-width: 1200px;
      margin: 40px auto;
      display: flex;
      gap: 40px;
    }

    .product-gallery {
      flex: 1;
      position: relative;
    }

    .product-gallery img {
      width: auto;
      border-radius: 10px;
      object-fit: contain;
    }

    .slider-nav-thumbnails img {
      border-radius: 8px;
      width: auto;
      cursor: pointer;
      transition: transform 0.2s ease;
    }

    .slider-nav-thumbnails img:hover {
      transform: scale(1.05);
    }

    .product-info {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .product-info h2 {
      font-size: 1.8rem;
      margin-bottom: 10px;
    }

    .price-section {
      margin: 20px 0;
      font-size: 1.3rem;
    }

    .price-section .old-price {
      color: #888;
      text-decoration: line-through;
      margin-left: 10px;
      font-size: 1rem;
    }

    .offer-tag {
      background-color: #1e918b;
      color: #fff;
      border-radius: 20px;
      padding: 5px 12px;
      font-size: 0.9rem;
      margin-left: 10px;
    }

    .product-description {
      margin: 20px 0;
      color: #444;
      line-height: 1.6;
    }

    .product-meta {
      font-size: 0.9rem;
      color: #777;
      margin-top: 15px;
    }

    .quantity-control {
      display: inline-flex;
      align-items: center;
      border: 1px solid #ddd;
      border-radius: 30px;
      padding: 5px 10px;
      gap: 10px;
    }

    .quantity-control a {
      color: #1e918b;
      font-weight: bold;
      cursor: pointer;
      text-decoration: none;
    }

    .add-to-cart-btn {
      background-color: #1e918b;
      color: #fff;
      border: none;
      padding: 12px 20px;
      border-radius: 30px;
      cursor: pointer;
      font-size: 1rem;
      transition: background-color 0.3s;
      margin-top: 15px;
    }

    .add-to-cart-btn:hover {
      background-color: #156f6b;
    }

    .wishlist-btn {
      background: none;
      border: none;
      color: #e74c3c;
      cursor: pointer;
      font-size: 1.4rem;
      margin-left: 15px;
    }

    .breadcrumb {
      background: #f9f9f9;
      padding: 10px 20px;
      border-radius: 8px;
      margin: 20px auto;
      max-width: 1200px;
      font-size: 0.9rem;
      color: #666;
    }

    .breadcrumb a {
      color: #1e918b;
      text-decoration: none;
    }

    .breadcrumb span {
      margin: 0 8px;
    }
    .product-gallery {
      max-width: 500px;
      margin: 0 auto;
    }

    .product-image-slider img {
      width: 100%;
      height: 450px;
      object-fit: contain;
      border-radius: 10px;
    }

    .slider-nav-thumbnails {
      margin-top: 15px;
    }

    .slider-nav-thumbnails .slick-slide {
      margin: 0 5px;
    }

    .slider-nav-thumbnails img {
      width: 100px;
      height: 80px;
      object-fit: contain;
      border-radius: 8px;
      cursor: pointer;
      border: 2px solid transparent;
      transition: border-color 0.3s;
    }

    .slider-nav-thumbnails .slick-current img {
      border-color: #1e918b;
    }

    .product-gallery {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 15px;
    }

    /* Main Image */
    #featuredPic {
      width: 350px;
      height: 350px;
      object-fit: contain;
      border-radius: 10px;
      transition: transform 0.3s ease;
      cursor: zoom-in;
    }

    #featuredPic:hover {
      transform: scale(1.05);
    }

    /* Thumbnail container */
    .slider-nav-thumbnails {
      display: flex;
      gap: 10px;
      justify-content: center;
      flex-wrap: nowrap;
      margin-top: 10px;
    }

    /* Thumbnails */
    .thumbImg {
      width: 70px;
      height: 70px;
      object-fit: cover;
      border-radius: 8px;
      flex-shrink: 0;
      opacity: 0.6;
      cursor: pointer;
      transition: 0.3s;
      border: 2px solid transparent;
    }

    .thumbImg:hover {
      opacity: 1;
      /* transform: scale(1.05); */
    }

    /* Active thumbnail */
    .thumb-active {
      opacity: 1;
      border-color: #007bff;
    }

#imageContainer {
  max-width: 375px;
  position: relative;
}

#featuredPic {
  width: 350px;
  height: 350px;
  object-fit: contain;
  cursor: zoom-in;
  border-radius: 10px;
}

#lens {
  position: absolute;
  height: 130px;
  width: 130px;
  border: 2px solid #000;
  border-radius: 10%;
  background-repeat: no-repeat;
  display: none;
  pointer-events: none;
  z-index: 10000;
}

.thumbslider {
  width: 380px;
  display: flex;
  justify-content: center;
  align-items: center;
  column-gap: 10px;
}

#sliderWrap {
  width: 300px;
  display: flex;
  overflow-x: scroll;
  gap: 10px;
  padding: 5px 0;
  scrollbar-width: none;
}

#sliderWrap::-webkit-scrollbar {
  display: none;
}

.thumbImg {
  width: 70px;
  height: 70px;
  object-fit: cover;
  border-radius: 8px;
  flex-shrink: 0;
  opacity: 0.6;
  cursor: pointer;
  transition: 0.3s;
  border: 2px solid transparent;
}

.thumb-active {
  opacity: 1;
  border-color: #007bff;
}

.arrow {
  width: 25px;
  height: 25px;
  flex-shrink: 0;
  cursor: pointer;
  opacity: 0.7;
  transition: 0.3s;
}

.arrow:hover {
  opacity: 1;
}

/* recommeded section */
.btn {
    display: inline-block;
    padding: 12px 20px;
    font-size: 16px;
    font-weight: bold;
    color: #fff;
    background-color: #ff6b6b;
    border: none;
    border-radius: 5px;
    transition: background-color 0.3s, transform 0.3s;
    cursor: pointer;
    text-align: center;
  }

  .btn:hover {
    background-color: #ff4c4c;
    transform: translateY(-2px);
  }

  .btn:active {
    transform: translateY(1px);
  }

  .wishlist-btn {
    position: absolute;
    top: 10px;
    right: 10px;
    background-color: rgba(255, 255, 255, 0.8);
    padding: 10px;
    border-radius: 50%;
    color: #ff6b6b;
    font-size: 18px;
    z-index: 10;
    transition: background-color 0.3s, color 0.3s, transform 0.3s;
  }

  .wishlist-btn:hover {
    background-color: rgba(255, 255, 255, 1);
    color: #ff4c4c;
    transform: translateY(-2px);
  }

  .wishlist-btn:active {
    transform: translateY(1px);
  }

  .product-img-action-wrap {
    position: relative;
  }

  .product-img {
    position: relative;
    display: block;
    overflow: hidden;
  }

  .product-cart-wrap {
    border: 1px solid #eee;
    padding: 20px;
    margin-bottom: 30px;
  }

  .product-content-wrap h6 {
    font-size: 18px;
    color: #333;
    margin-bottom: 5px;
  }

  .product-content-wrap h5 {
    font-size: 16px;
    color: #ff6b6b;
    margin-bottom: 10px;
  }

  .product-content-wrap a {
    display: inline-block;
    padding: 8px 12px;
    background-color: #ff6b6b;
    color: white;
    text-transform: uppercase;
    font-size: 14px;
    border-radius: 4px;
    text-decoration: none;
  }

  .product-content-wrap a:hover {
    background-color: #ff4c4c;
  }

 .recommended-product h3 {
  font-size: 24px;
  margin-bottom: 20px;
  color: #333;
  text-align: left;
}

.recommended-product .product-cart-wrap {
  border: 1px solid #f0f0f0; /* lighter border */
  padding: 15px;              /* slightly smaller padding */
  margin-bottom: 20px;        /* less spacing */
  transition: transform 0.3s;
}

.recommended-product .product-cart-wrap:hover {
  transform: translateY(-3px);
  box-shadow: 0 4px 15px rgba(0,0,0,0.1);
}

.recommended-product .product-content-wrap h6 {
  font-size: 16px;  /* smaller font than main product */
  margin-bottom: 3px;
}

.recommended-product .product-content-wrap h5 {
  font-size: 14px;
  color: #ff6b6b;
  margin-bottom: 5px;
}

.recommended-product .product-content-wrap a {
  padding: 6px 10px;
  font-size: 13px;
}

/* review section */
#reviewsContainer {
  margin-top: 20px;
  display: flex;
  flex-direction: column;
  gap: 15px;
}

.review-card {
  border: 1px solid #eee;
  padding: 15px;
  border-radius: 8px;
  background-color: #fafafa;
  width: 100%;
}

.review-card strong {
  color: #333;
}

.review-card span {
  color: #ffb400; /* stars color */
  margin-left: 5px;
}

.review-card p {
  margin-top: 5px;
  color: #555;
}


  </style>

  
