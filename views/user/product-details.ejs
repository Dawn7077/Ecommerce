  <div class="product-gallery">
    <div id="imageContainer" class="d-flex justify-content-center">
      <div id="lens"></div>
        <img
          id="featuredPic"
          src="/uploads/product-image/<%= product.productImage[0] %>"
          alt="Product Image"
        /> 
    </div>
    <div class="thumbslider d-flex align-items-center mt-3">
      <img src="/img/icon/arrow-left.png" alt="" id="slideLeft" class="arrow" style="width: 20px;"/> 
      <div id="sliderWrap">
        <% product.productImage.forEach(img => { %>
        <img
          class="thumbImg"
          src="/uploads/product-image/<%= img %>"
          alt="Thumbnail"
        />
        <% }) %>
      </div> 
      <img src="/img/icon/arrow-right.png" alt="" id="slideRight" class="arrow"  style="width: 20px;"/>
    </div>
    

    
  </div> 
  
  <!-- Product Details -->
  <div class="product-info">
    <div>
      <h2><%= product.productName %></h2>
      <p><strong>Brand:</strong> <%= product.brand %></p>

      <div class="price-section">
        <!-- ₹<%= product.salesPrice.toLocaleString('en-IN') %>
        <span class="old-price" style="color: #f16c5d;"
          >₹<%= product.regularPrice.toLocaleString('en-IN') %></span
        >
        <% if (totalOffer) { %>
        <span class="offer-tag"><%= totalOffer %>% OFF</span>
        <% } %> -->
        <% 
        const effectiveDiscount = totalOffer
        const discountedPrice = product.regularPrice - Math.floor(product.regularPrice*effectiveDiscount/100) %>
        <span class="new-price">₹<%= discountedPrice.toLocaleString('en-IN') %></span>
        <span class="old-price" style="color: #f16c5d;"
          >₹<%= product.regularPrice.toLocaleString('en-IN') %></span
      </div>

      <div class="product-description">
        <%- (product.description || '').replace(/\r?\n/g, '<br />') %>
      </div>

      <script>
        let cat = product.category;
        document.getElementById("cat").innerText = cat.name;
      </script>

      <ul class="product-meta">
        <li id="cat">
          <strong>Category:</strong><%= product.category[0].name %>
        </li>
        <% if(quantity<1){ %>
          <li><strong style="color: #e74c3c;">Availability:</strong> Out of stock</li>
          <% }else if(product.isBlocked){ %>
            <li style="color: #000;"><strong style="color: #e74c3c;">Availability:</strong> This Product is No longer available</li> 
          <% }else{ %>
            <li><strong>Availability:</strong> <%= quantity %> in stock</li>
            <% } %>
        <li><strong>Warranty:</strong> 1 year brand warranty</li>
        <li><strong>Rating:</strong>★★★★☆<span style="margin-left:5px; color:#777;">(4.0)</span>
          </li>
        <% if(totalOffer){ %>
          <li><strong>Discount:</strong><%= totalOffer %>%</li>
        <% } %>
      </ul>
    </div>

    <div>
      <div class="quantity-control mt-3">
        <a href="#" class="qty-down">−</a>
        <span id="quantity">1</span>
        <a href="#" class="qty-up">+</a>
      </div>

      <div>
        <button class="add-to-cart-btn">Add to Cart</button>
        <button class="wishlist-btn" title="Add to Wishlist">❤️</button>
      </div>
    </div>
  </div>
</main> 

<!-- highlights -->
