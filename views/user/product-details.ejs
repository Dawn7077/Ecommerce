      margin: 20px 0;
      font-size: 1.3rem;
    }

    .price-section .old-price {
      color: #888;
      text-decoration: line-through;
      margin-left: 10px;
      font-size: 1rem;
    }

    .offer-tag {
      background-color: #1e918b;
      color: #fff;
      border-radius: 20px;
      padding: 5px 12px;
      font-size: 0.9rem;
      margin-left: 10px;
    }

    .product-description {
      margin: 20px 0;
      color: #444;
      line-height: 1.6;
    }

    .product-meta {
      font-size: 0.9rem;
      color: #777;
      margin-top: 15px;
    }

    .quantity-control {
      display: inline-flex;
      align-items: center;
      border: 1px solid #ddd;
      border-radius: 30px;
      padding: 5px 10px;
      gap: 10px;
    }

    .quantity-control a {
      color: #1e918b;
      font-weight: bold;
      cursor: pointer;
      text-decoration: none;
    }

    .add-to-cart-btn {
      background-color: #1e918b;
      color: #fff;
      border: none;
      padding: 12px 20px;
      border-radius: 30px;
      cursor: pointer;
      font-size: 1rem;
      transition: background-color 0.3s;
      margin-top: 15px;
    }

    .add-to-cart-btn:hover {
      background-color: #156f6b;
    }

    .wishlist-btn {
      background: none;
      border: none;
      color: #e74c3c;
      cursor: pointer;
      font-size: 1.4rem;
      margin-left: 15px;
    }

    .breadcrumb {
      background: #f9f9f9;
      padding: 10px 20px;
      border-radius: 8px;
      margin: 20px auto;
      max-width: 1200px;
      font-size: 0.9rem;
      color: #666;
    }

    .breadcrumb a {
      color: #1e918b;
      text-decoration: none;
    }

    .breadcrumb span {
      margin: 0 8px;
    }
    .product-gallery {
      max-width: 500px;
      margin: 0 auto;
    }

    .product-image-slider img {
      width: 100%;
      height: 450px;
      object-fit: contain;
      border-radius: 10px;
    }

    .slider-nav-thumbnails {
      margin-top: 15px;
    }

    .slider-nav-thumbnails .slick-slide {
      margin: 0 5px;
    }

    .slider-nav-thumbnails img {
      width: 100px;
      height: 80px;
      object-fit: contain;
      border-radius: 8px;
      cursor: pointer;
      border: 2px solid transparent;
      transition: border-color 0.3s;
    }

    .slider-nav-thumbnails .slick-current img {
      border-color: #1e918b;
    }

    .product-gallery {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 15px;
    }

    /* Main Image */
    #featuredPic {
      width: 350px;
      height: 350px;
      object-fit: contain;
      border-radius: 10px;
      transition: transform 0.3s ease;
      cursor: zoom-in;
    }

    #featuredPic:hover {
      transform: scale(1.05);
    }

    /* Thumbnail container */
    .slider-nav-thumbnails {
      display: flex;
      gap: 10px;
      justify-content: center;
      flex-wrap: nowrap;
      margin-top: 10px;
    }

    /* Thumbnails */
    .thumbImg {
      width: 70px;
      height: 70px;
      object-fit: cover;
      border-radius: 8px;
      flex-shrink: 0;
      opacity: 0.6;
      cursor: pointer;
      transition: 0.3s;
      border: 2px solid transparent;
    }

    .thumbImg:hover {
      opacity: 1;
      /* transform: scale(1.05); */
    }

    /* Active thumbnail */
    .thumb-active {
      opacity: 1;
      border-color: #007bff;
    }

#imageContainer {
