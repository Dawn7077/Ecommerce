<style>
    body { font-family: Arial; background:#f4f4f4; padding:20px; }
    .order-card { background:white; padding:15px; margin-bottom:15px; border-radius:6px; border:1px solid #ddd; }
    .order-id { font-weight:bold; }
    .order-status { padding:4px 8px; border-radius:4px; font-size:12px; }
