<!-- Filter Buttons -->
<div>
    <button class="filter-btn active" data-filter="all">All</button>
    <button class="filter-btn" data-filter="pending">Pending</button>
    <button class="filter-btn" data-filter="delivered">Delivered</button>
    <button class="filter-btn" data-filter="cancelled">Cancelled</button>
</div>

<br>

<!-- Search Input -->
<input type="text" id="searchInput" placeholder="Search Orders..." style="padding:8px; width:250px">

<br><br>

<!-- ORDERS -->
<div id="ordersList">

    <div class="order-card"
         data-order-id="ORD001"
         data-status="delivered">
        <div class="order-id">Order: ORD001</div>
        <div class="order-status status-delivered">Delivered</div>
    </div>

    <div class="order-card"
         data-order-id="ORD002"
         data-status="pending">
        <div class="order-id">Order: ORD002</div>
        <div class="order-status status-pending">Pending</div>
    </div>

    <div class="order-card"
         data-order-id="ORD003"
         data-status="cancelled">
        <div class="order-id">Order: ORD003</div>
        <div class="order-status status-cancelled">Cancelled</div>
    </div>

</div>


<script>
// 🧩 STATUS FILTERING
document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
        
        document.querySelectorAll('.filter-btn')
            .forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.dataset.filter;
        const cards = document.querySelectorAll('.order-card');

        cards.forEach(card => {
            if (filter === "all" || card.dataset.status === filter) {
                card.classList.remove('hidden');
            } else {
                card.classList.add('hidden');
            }
        });
    });
});


// 🔍 SEARCH BY ORDER ID
document.getElementById("searchInput").addEventListener("input", () => {
    const search = document.getElementById("searchInput").value.toLowerCase();
    const cards = document.querySelectorAll('.order-card');

    cards.forEach(card => {
        const orderId = card.dataset.orderId.toLowerCase();
        if (orderId.includes(search)) {
            card.classList.remove("hidden");
        } else {
            card.classList.add("hidden");
        }
    });
});
</script>

 




</body>

