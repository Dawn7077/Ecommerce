        /* --- Stylish Forgot Password Page --- */

.forgot-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 60px 15px;
}

.forgot-card {
    width: 100%;
    max-width: 420px;
    padding: 35px 30px;
    background: #fff;
    border-radius: 12px;
    box-shadow: 0 8px 24px rgba(0,0,0,0.08);
    animation: fadeUp 0.6s ease; 
}

@keyframes fadeUp {
    from { opacity: 0; transform: translateY(15px); }
    to   { opacity: 1; transform: translateY(0); }
}

.forgot-card h4 {
    font-weight: 700;
    font-size: 22px;
    color: #222;
    text-align: center;
}

.forgot-desc {
    font-size: 14px;
    color: #555;
    text-align: center;
    margin-bottom: 20px;
}

.form-control {
    height: 44px;
    border-radius: 8px;
    border: 1px solid #ddd;
    font-size: 14px;
}

.form-control:focus {
    border-color: #6c63ff;
    box-shadow: 0 0 0 0.15rem rgba(108, 99, 255, 0.3);
}

.btn-primary {
    background: #6c63ff;
    border: none;
    height: 44px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 15px;
    transition: 0.3s;
}

.btn-primary:hover {
    background: #584df2;
    transform: translateY(-2px);
}

.back-link {
    text-align: center;
    margin-top: 15px;
    font-size: 14px;
}

.back-link a {
    font-weight: 600;
    color: #6c63ff;
    transition: 0.3s;
}

.back-link a:hover {
    color: #463fd6;
    text-decoration: underline;
}

.error-message {
    color: #ff5252;
    font-size: 13px;
    margin-top: 5px;
    display: none;
    font-weight: 600;
}

    </style>
