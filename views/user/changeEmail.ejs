<%- include("../../views/partials/user/header") %>

<link rel="stylesheet" href="/user/Style/changeEmail.css">

 <section class="forgot-wrapper">
            <div class="forgot-card">

                <h4>Email Change</h4>
                <p class="forgot-desc">
                    Enter your registered email address to receive a reset link.
                </p>

                <form method="post" action="/change-email" onsubmit="return validateLoginForm()">
                    <div class="mb-3">
                        <label class="form-label">Email Address</label>
                        <input class="form-control" type="text" name="email" id="email" placeholder="example@mail.com">
                        <div class="error-message" id="email-error"></div>
                    </div>
                    <style>
                        .buttonred[type='submit']:hover{
                            background-color: #da3d3d;
                            transform: translateY(-2px);
                        }
                    </style>
                    
                    <button type="submit" class="buttonred w-100" style="background-color: #ff5252; border: none;">
                        Send Reset Link &nbsp; <i class="fas fa-paper-plane"></i>
                    </button>
                </form> 

            </div>
        </section>

<script src="/user/js/changeEmailScript.js"></script>



<%- include("../../views/partials/user/footer") %>



