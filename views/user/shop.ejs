<style>
 .main-container {
   max-width: 1200px;
   margin: 0 auto;
   padding: 20px;
 }
 .shop-topbar {
   display: flex; 
   justify-content: space-between;
   align-items: center;
   margin-bottom: 20px;
 }

 .search-form {
  display: flex;
  align-items: center;
  background: #f5f7fa;
  border: 1px solid #d6dce5;
  border-radius: 8px;
  padding: 6px 14px;
  width: 260px;
  transition: 0.3s ease;
  box-shadow: inset 0 1px 3px rgba(0,0,0,0.06);
}
  .search-form:focus-within {
  border-color: #1c72e3;
  box-shadow: 0 4px 12px rgba(28,114,227,0.18);
}


.search-input {
  border: none;
  outline: none;
  background: transparent;
  flex: 1;
