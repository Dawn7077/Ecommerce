     <% } %>


     <% for (let i = 1; i <= totalPages; i++) { %>
       <a class="btn <%= currentPage === i ? 'active' : '' %>" href="/shop?page=<%= i %><%= selectedCategory ? '&category=' + selectedCategory : '' %><%= selectedBrand ? '&brand=' + selectedBrand : '' %><%= searchQuery ? '&search=' + searchQuery : '' %><%= sort ? '&sort=' + sort : '' %><%= selectedPrice?.gt ? '&gt=' + selectedPrice.gt : '' %><%= selectedPrice?.lt ? '&lt=' + selectedPrice.lt : '' %> "><%= i %></a>
     <% } %>


     <% if (currentPage < totalPages) { %>
       <a class="btn" href="/shop?page=<%= currentPage + 1 %><%= selectedCategory ? '&category=' + selectedCategory : '' %><%= selectedBrand ? '&brand=' + selectedBrand : '' %><%= searchQuery ? '&search=' + searchQuery : '' %><%= sort ? '&sort=' + sort : '' %><%= selectedPrice?.gt ? '&gt=' + selectedPrice.gt : '' %><%= selectedPrice?.lt ? '&lt=' + selectedPrice.lt : '' %>">Next</a>
     <% } %>
   </div>


  
 </section>
