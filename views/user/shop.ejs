<%- include("../../views/partials/user/header") %>
<%- include("../../views/partials/user/crumbs") %>

<link rel="stylesheet" href="/user/Style/shop.css">

<div class="main-container">
 <section class="shop-page container">
   <div class="shop-topbar">
     <div class="search-bar">
        <form action="/shop" method="GET" class="search-form"> 
            <!-- Input -->
            <input type="text" 
                name="search" 
                value="<%= searchQuery || '' %>" 
                placeholder="Search items..."
                class="search-input"> 
            <!-- Show X only when searching -->
            <% if (searchQuery) { %>
                <a href="/shop" class="search-clear-btn">&times;</a>
            <% } %>  
            <button type="submit" class="search-icon-btn" >
                Search
            </button>
        </form> 


     </div>
     <div class="sort-dropdown">
      <form id="sortForm" action="/shop" method="GET"> 
        <input type="hidden" name="category" value="<%= selectedCategory || '' %>"> 
        <input type="hidden" name="brand" value="<%= selectedBrand || '' %>"> 
        <input type="hidden" name="search" value="<%= searchQuery || '' %>"> 
        <input type="hidden" name="gt" value="<%= selectedPrice?.gt || '' %>">
        <input type="hidden" name="lt" value="<%= selectedPrice?.lt || '' %>">
        <select name="sort"  onchange="document.getElementById('sortForm').submit()">
          <option value="">Sort by</option>
          <option value="az" <%= sort === 'az'?'selected':'' %>>A-Z</option>
          <option value="za" <%= sort === 'za'?'selected':'' %>>Z-A</option>
          <option value="low-high" <%= sort === 'low-high'?'selected':'' %>>low-high</option>
          <option value="high-low" <%= sort === 'high-low'?'selected':'' %>>high-low</option>
        </select>
      </form>
     </div>
   </div>
  
   <div class="product-list-container">
     <aside class="sidebar">
       <div class="filter-section">
         <div class="filter-title"><a href="/shop" style="text-decoration: none; color: #333;">Categories</a></div>
         <div class="category-brand-container">
           <ul>
            <% for(let i=0;i<category.length;i++){ %>
               <li class="filter-item">
                <a href="/shop?category=<%= category[i]._id %><%= selectedBrand ? '&brand=' + selectedBrand : '' %><%= searchQuery?'&search='+searchQuery:'' %><%= sort?'&sort='+sort:'' %><%= selectedPrice?.gt?'&gt='+selectedPrice.gt:'' %><%= selectedPrice?.lt?'&lt='+selectedPrice.lt:'' %>" 
                class="<%= selectedCategory == category[i]._id ? 'active-filter' : '' %>">
                <%= category[i].name %>
                </a>

               </li>
               <% } %>
           </ul>
         </div>
       </div>
       

      
       <div class="filter-section">
         <div class="filter-title"><a href="/shop" style="text-decoration: none; color: #333;">Brands</a></div>
         <div class="category-brand-container">
           <ul>
            <% for(let i=0;i<brand.length;i++){ %>
               <li class="filter-item">
                <a href="/shop?brand=<%= brand[i]._id %><%= selectedCategory ? '&category=' + selectedCategory : '' %><%= searchQuery?'&search='+searchQuery:'' %><%= sort?'&sort='+sort:'' %><%= selectedPrice?.gt?'&gt='+selectedPrice.gt:'' %><%= selectedPrice?.lt?'&lt='+selectedPrice.lt:'' %>" 
                class="<%= selectedBrand == brand[i]._id ? 'active-filter' : '' %>">
                <%= brand[i].brandName %>
                </a>

               </li>
               <% } %>
           </ul>
         </div>
       </div>
       

      
       <div class="price-filter">
         <div class="filter-title"><a href="/shop" style="text-decoration: none; color: #333;">Filter by Price</a></div>
         <form id="price-filter-form">
           <div class="price-options">
             <a href="/shop?gt=0&lt=500
              <%= selectedCategory ? '&category=' + selectedCategory : '' %>
              <%= selectedBrand ? '&brand=' + selectedBrand : '' %>
              <%= searchQuery ? '&search=' + searchQuery : '' %>
              <%= sort ? '&sort=' + sort : '' %> 
             " class="<%= selectedPrice && selectedPrice.gt == 0 && selectedPrice.lt == 500 ? 'active-filter' : '' %>"
             ><button type="button" class="price-button">Under ₹500</button></a>

             <a href="/shop?gt=500&lt=1000<%= selectedCategory ? '&category=' + selectedCategory : '' %><%= selectedBrand ? '&brand=' + selectedBrand : '' %><%= searchQuery ? '&search=' + searchQuery : '' %><%= sort ? '&sort=' + sort : '' %>"  
              class="<%= selectedPrice && selectedPrice.gt == 500 && selectedPrice.lt == 1000 ? 'active-filter' : '' %>"
             ><button type="button" class="price-button">₹500 - ₹1000</button></a>

             <a href="/shop?gt=1000&lt=2500<%= selectedCategory ? '&category=' + selectedCategory : '' %><%= selectedBrand ? '&brand=' + selectedBrand : '' %><%= searchQuery ? '&search=' + searchQuery : '' %><%= sort ? '&sort=' + sort : '' %>" 
               class="<%= selectedPrice && selectedPrice.gt == 1000 && selectedPrice.lt == 2500 ? 'active-filter' : '' %>"
             ><button type="button" class="price-button">₹1000- ₹2500</button></a>

             <a href="/shop?gt=2500&lt=100000<%= selectedCategory ? '&category=' + selectedCategory : '' %><%= selectedBrand ? '&brand=' + selectedBrand : '' %><%= searchQuery ? '&search=' + searchQuery : '' %><%= sort ? '&sort=' + sort : '' %>" 
              class="<%= selectedPrice && selectedPrice.gt == 2500 && selectedPrice.lt == 100000  ? 'active-filter' : '' %>"
             ><button type="button" class="price-button">Above ₹2500</button></a>
           </div>
         </form>
       </div>

       
     </aside>
     

     <main class="product-grid">
        <% for(let i=0;i<products.length;i++){ %>
         <div class="product-card">
          <% const isWishlisted  = wishlist.some(p=>p.productId.toString() === products[i]._id.toString() ) %>
            <% if(user) {%>
              <span id="wishlist-btn-<%=products[i]._id%>" class="wishlist-btn" onclick="addToWishlist('<%=products[i]._id%>')">
               <i class="<%= isWishlisted ? 'fas' : 'far' %> fa-heart" style="color: red;"></i></span>
            <% }else {%>
              <span id="wishlist-btn-<%=products[i]._id%>" class="wishlist-btn" onclick="redirectLogin()">
               <i class="<%= isWishlisted ? 'fas' : 'far' %> fa-heart" style="color: red;"></i></span>
            <% } %>
               
           <a href="/productDetails?id=<%=products[i]._id %>">
             <img src="/uploads/product-image/<%= products[i].productImage[0] %>" alt="<%= products[i].productName %>" />
             <h4><%= products[i].productName %></h4>
             <p>Brand:<%= products[i].brand %></p>
             <p>Price:₹<%= products[i].salesPrice.toLocaleString('en-IN') %> 
              <% if( products[i].salesPrice < products[i].regularPrice ) {%>
              <span class="text-muted"><strike> ₹ <%= products[i].regularPrice.toLocaleString('en-IN') %></strike></span>
              <% } %>
            </p>
           </a>
           <% if(user) {%>
                    <button style="background-color:#ff6b6b; ;"onmouseover="this.style.backgroundColor='#ee5353; '"
          onmouseout="this.style.backgroundColor='#ff6b6b;'" class="add-to-cart-btn" onclick="addToCart('<%=products[i]._id%>')">Add to Cart</button>
          
          <% }else {%>
            <button style="background-color:#ff6b6b; ;"onmouseover="this.style.backgroundColor='#ee5353; '"
            onmouseout="this.style.backgroundColor='#ff6b6b;'" class="add-to-cart-btn" onclick="redirectLogin()">Add to Cart</button>
            
            <% } %>
         </div>
         <% } %>
     </main>
   </div>

   <style>
    /* --- AMAZON STYLE VARIANT POPUP --- */

.variant-modal-overlay {
  position: fixed;
  top: 0; left: 0;
  width: 100%; height: 100%;
  background: rgba(0,0,0,0.55);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 5000;
}

.variant-modal {
  width: 350px;
  background: white;
  border-radius: 10px;
  padding: 20px;
  animation: fadeIn 0.3s ease;
  box-shadow: 0px 5px 20px rgba(0,0,0,0.25);
}

.variant-modal h3 {
  margin-bottom: 15px;
  text-align: center;
  color: #1c3e64;
}

.variant-group {
  margin-bottom: 15px;
}

.variant-select {
  width: 100%;
  padding: 10px;
  border-radius: 6px;
  border: 1px solid #d0dce7;
  font-size: 15px;
}

.modal-buttons {
  display: flex;
  justify-content: space-between;
  margin-top: 15px;
}

.modal-cancel {
  background: #feedd5;
  border: none;
  padding: 10px 18px;
  border-radius: 6px;
  cursor: pointer;
}

.modal-confirm {
  background: #1c72e3;
  border: none;
  color: white;
  padding: 10px 18px;
  border-radius: 6px;
  cursor: pointer;
}

.modal-confirm:hover {
  background: #155ec0;
}

@keyframes fadeIn {
  from { opacity: 0; transform: scale(0.95); }
  to { opacity: 1; transform: scale(1); }
}

   </style>
<!-- variant selection -->
   <div id="variantModal"  class="variant-modal-overlay" style="display: none;"> 
    <div class="variant-modal">
      
      <h3>Select Variant</h3>

      <div class="variant-group">
        <label >Color:</label>
        <select id="variantColor" class="variant-select" ></select>
      </div> 

      <div class="variant-group">
        <label >Size:</label>
        <select id="variantSize" class="variant-select" ></select>
      </div>

      <div class="modal-buttons">
        <button onclick="closeVariantModal()" class="modal-cancel">Cancel</button>
        <button onclick="confirmAddToCart()" class="modal-confirm">Add to Cart</button>
      </div>

    </div>
   </div>


    <div class="pagination">
     <% if (currentPage > 1) { %>
       <a class="btn" href="/shop?page=<%= currentPage - 1 %><%= selectedCategory ? '&category=' + selectedCategory : '' %><%= selectedBrand ? '&brand=' + selectedBrand : '' %><%= searchQuery ? '&search=' + searchQuery : '' %><%= sort ? '&sort=' + sort : '' %><%= selectedPrice?.gt ? '&gt=' + selectedPrice.gt : '' %><%= selectedPrice?.lt ? '&lt=' + selectedPrice.lt : '' %>">Prev</a>
     <% } %>


     <% for (let i = 1; i <= totalPages; i++) { %>
       <a class="btn <%= currentPage === i ? 'active' : '' %>" href="/shop?page=<%= i %><%= selectedCategory ? '&category=' + selectedCategory : '' %><%= selectedBrand ? '&brand=' + selectedBrand : '' %><%= searchQuery ? '&search=' + searchQuery : '' %><%= sort ? '&sort=' + sort : '' %><%= selectedPrice?.gt ? '&gt=' + selectedPrice.gt : '' %><%= selectedPrice?.lt ? '&lt=' + selectedPrice.lt : '' %> "><%= i %></a>
     <% } %>


     <% if (currentPage < totalPages) { %>
       <a class="btn" href="/shop?page=<%= currentPage + 1 %><%= selectedCategory ? '&category=' + selectedCategory : '' %><%= selectedBrand ? '&brand=' + selectedBrand : '' %><%= searchQuery ? '&search=' + searchQuery : '' %><%= sort ? '&sort=' + sort : '' %><%= selectedPrice?.gt ? '&gt=' + selectedPrice.gt : '' %><%= selectedPrice?.lt ? '&lt=' + selectedPrice.lt : '' %>">Next</a>
     <% } %>
   </div>


  
 </section>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"></script>
<script src="/user/js/shop.js"></script>
<%- include("../../views/partials/user/footer") %>






