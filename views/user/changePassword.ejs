<%- include("../../views/partials/user/header") %>
<section class="content-main mt-80 mb-80">
   <div class="card mx-auto card-login col-4">
       <div class="card-body">
           <h4 class="card-title mb-4">Email</h4>
           <form method="post" action="/change-password" onsubmit="return validateLoginForm()">
               <div class="mb-3">
                   <input class="form-control" name="email" placeholder="Email" type="text" id="email">
                   <div class="error-message" id="email-error"></div>
               </div>
               <div class="mb-4">
                   <button type="submit" class="btn btn-primary w-100">Verify</button>
               </div>
           </form>
         
          <!-- hi -->
       </div>
   </div>
</section>
<script src="/user/js/changePasswordScript.js"></script>
<%- include("../../views/partials/user/footer") %>

